#!/usr/bin/env bash
#MISE description="Verify the Mise toolchain and required host services"
set -euo pipefail

missing_system=()
for command_name in git curl; do
  command -v "$command_name" >/dev/null 2>&1 || missing_system+=("$command_name")
done

if ((${#missing_system[@]})); then
  printf 'Missing host bootstrap prerequisites: %s\n' "${missing_system[*]}" >&2
  printf 'Install them with your OS package manager, then rerun `mise run setup`.\n' >&2
  exit 1
fi

missing_mise=()
for command_name in docker docker-compose clang make perl tar templ gopls; do
  command -v "$command_name" >/dev/null 2>&1 || missing_mise+=("$command_name")
done

if ((${#missing_mise[@]})); then
  printf 'Missing Mise-managed tools: %s\n' "${missing_mise[*]}" >&2
  printf 'Run `mise install`, then rerun `mise run doctor`.\n' >&2
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  printf 'The Mise-managed Docker client cannot reach a Docker daemon.\n' >&2
  printf 'Start Docker Desktop or the host Docker service, then retry.\n' >&2
  exit 1
fi

docker-compose version >/dev/null
printf 'Development toolchain and Docker daemon are available.\n'
