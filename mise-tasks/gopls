#!/usr/bin/env bash
#MISE description="Fail on gopls diagnostics, including hints"
set -euo pipefail

cd "$MISE_PROJECT_ROOT"

files=()
if (($# == 0)); then
  while IFS= read -r file; do
    case "$file" in
      *_templ.go) ;;
      *) files+=("$file") ;;
    esac
  done < <(git ls-files '*.go')
else
  for file in "$@"; do
    case "$file" in
      *_templ.go) ;;
      *) files+=("$file") ;;
    esac
  done
fi

((${#files[@]})) || exit 0

export GOFLAGS="${GOFLAGS:-} -tags=e2e"
if ! diagnostics="$(gopls check -severity=hint "${files[@]}" 2>&1)"; then
  printf '%s\n' "$diagnostics" >&2
  exit 1
fi
if [[ -n "$diagnostics" ]]; then
  printf '%s\n' "$diagnostics" >&2
  exit 1
fi
