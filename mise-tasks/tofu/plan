#!/usr/bin/env bash
#MISE description="Generate and show an OpenTofu execution plan"
set -euo pipefail

if [ -z "${FLY_API_TOKEN:-}" ]; then
  FLY_API_TOKEN="$(flyctl auth token 2>/dev/null | tail -n 1 || true)"
  if [ -z "$FLY_API_TOKEN" ]; then
    flyctl auth login
    FLY_API_TOKEN="$(flyctl auth token 2>/dev/null | tail -n 1)"
  fi
  export FLY_API_TOKEN
fi

if [ ! -f "$MISE_PROJECT_ROOT/terraform/terraform.tfstate" ]; then
  "$MISE_PROJECT_ROOT/mise-tasks/tofu/state-pull" || true
fi

cd "$MISE_PROJECT_ROOT/terraform"
tofu plan "$@"
