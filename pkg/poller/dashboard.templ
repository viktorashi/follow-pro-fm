package poller

import (
	"fmt"
	"net/url"
	"strings"
	"time"
)

func isWordHighlighted(word string, tags []ContestTag) bool {
	cleanWord := strings.Trim(strings.ToLower(word), ".,!?\"'")
	for _, tag := range tags {
		if tag.Source == triggerSourceTranscription && tag.Phrase != "" {
			phraseWords := strings.Fields(tag.Phrase)
			for _, pw := range phraseWords {
				cleanPw := strings.Trim(strings.ToLower(pw), ".,!?\"'")
				if cleanWord == cleanPw {
					return true
				}
			}
		}
	}
	return false
}

func templateSafe(s string) string {
	return strings.ReplaceAll(strings.ReplaceAll(s, "'", "\\'"), "\"", "\\\"")
}

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title }</title>
		<!-- HTMX -->
		<script src="/static/htmx.min.js"></script>
		<script src="/static/sse.js"></script>
		<script src="https://unpkg.com/wavesurfer.js@7/dist/wavesurfer.min.js"></script>
		<script src="https://unpkg.com/wavesurfer.js@7/dist/plugins/regions.min.js"></script>
		<link rel="stylesheet" href="/static/style.css"/>
	</head>
	<body class="flex flex-col">
		<div class="flex-grow flex flex-col">
			{ children... }
		</div>
	</body>
	</html>
}

templ Login() {
	@Layout("Login - ProFM Jaguare") {
		<div class="flex flex-col items-center justify-center flex-grow p-4">
			<div class="glass p-8 max-w-md w-full">
				<h1 class="title-large">Jaguare Login</h1>
				
				<form action="/login" method="POST" class="space-y-4">
					<div>
						<label class="text-sm font-medium mb-1">Trusted Email</label>
						<input type="email" name="email" required class="input"/>
					</div>
					<div>
						<label class="text-sm font-medium mb-1">Password</label>
						<input type="password" name="password" required class="input"/>
					</div>
					<button type="submit" class="btn btn-primary">Login</button>
				</form>

				<div class="mt-6 border-t pt-6">
					<form hx-post="/auth/magic/request" hx-target="#magic-result" class="space-y-4">
						<p class="text-sm text-muted text-center mb-2">Or use Magic Link</p>
						<div>
							<input type="email" name="email" placeholder="Enter Trusted Email" required class="input"/>
						</div>
						<button type="submit" class="btn btn-success">NU MAI STIU PAROLA AAA</button>
						<div id="magic-result" class="text-sm text-success text-center mt-2"></div>
					</form>
				</div>
			</div>
		</div>
	}
}

templ Dashboard(state AppState, chunks []ReviewChunk, canonicalChunks []ReviewChunk, phones []string, schedules []ScheduleEntry, campaignArtists []string, campaignPhrases map[string][]string, persons []Person, personAudios map[string]PersonAudioFiles) {
	@Layout("Dashboard - ProFM Jaguare") {
		<script>
			function toggleGathering() {
				fetch('/api/settings/gathering', {method: 'POST'})
					.then(() => window.location.reload());
			}
			function createPerson(event, form) {
				event.preventDefault();
				const data = new FormData(form);
				fetch('/api/persons', {
					method: 'POST',
					body: data
				}).then(async res => {
					if (!res.ok) {
						const payload = await res.json().catch(() => ({}));
						throw new Error(payload.error || 'Failed to create person');
					}
					window.location.reload();
				}).catch(err => alert(err.message));
				return false;
			}
			function editPerson(id, currentName) {
				const newName = prompt("Edit Person Name:", currentName);
				if (!newName || newName.trim() === "" || newName.trim() === currentName) return;
				const data = new FormData();
				data.append("name", newName.trim());
				fetch(`/api/persons/${id}/edit`, {
					method: 'POST',
					body: data
				}).then(async res => {
					if (!res.ok) {
						const payload = await res.json().catch(() => ({}));
						throw new Error(payload.error || 'Failed to update person');
					}
					window.location.reload();
				}).catch(err => alert(err.message));
			}
			function deletePerson(id, name) {
				if (!confirm(`Are you sure you want to delete person "${name}"? Any assigned phones will become unassigned!`)) return;
				fetch(`/api/persons/${id}/delete`, {
					method: 'POST'
				}).then(async res => {
					if (!res.ok) {
						const payload = await res.json().catch(() => ({}));
						throw new Error(payload.error || 'Failed to delete person');
					}
					window.location.reload();
				}).catch(err => alert(err.message));
			}
			function assignPhone(phone, personId) {
				const data = new FormData();
				data.append("phone", phone);
				data.append("person_id", personId);
				fetch('/api/phones/assign', {
					method: 'POST',
					body: data
				}).then(async res => {
					if (!res.ok) {
						const payload = await res.json().catch(() => ({}));
						throw new Error(payload.error || 'Failed to assign phone');
					}
					window.location.reload();
				}).catch(err => alert(err.message));
			}
			function toggleSelectAllAudios(personSlug, checked) {
				document.querySelectorAll(`.audio-checkbox-${personSlug}`).forEach(cb => {
					cb.checked = checked;
				});
			}
			function batchMoveAudios(fromSlug) {
				const targetSelect = document.getElementById(`target-person-${fromSlug}`);
				if (!targetSelect) return;
				const toSlug = targetSelect.value;
				if (!toSlug) {
					alert("Please select a target person to move files to.");
					return;
				}
				if (toSlug === fromSlug) {
					alert("Cannot move files to the same person.");
					return;
				}
				const selectedFiles = [];
				document.querySelectorAll(`.audio-checkbox-${fromSlug}:checked`).forEach(cb => {
					selectedFiles.push(cb.value);
				});
				if (selectedFiles.length === 0) {
					alert("Please select at least one audio file to move.");
					return;
				}
				if (!confirm(`Move ${selectedFiles.length} file(s) from ${fromSlug} to ${toSlug}?`)) return;
				fetch('/api/audios/batch-move', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						from_slug: fromSlug,
						to_slug: toSlug,
						files: selectedFiles
					})
				}).then(async res => {
					const payload = await res.json().catch(() => ({}));
					if (!res.ok) throw new Error(payload.error || 'Move failed');
					alert(`Successfully moved ${payload.moved} voice note(s)!`);
					window.location.reload();
				}).catch(err => alert(err.message));
			}
			function cropUnreviewed(event, form) {
				event.preventDefault();
				const data = new FormData(form);
				fetch('/unreviewed/crop', {
					method: 'POST',
					body: data
				}).then(async res => {
					if (!res.ok) {
						const payload = await res.json().catch(() => ({}));
						throw new Error(payload.error || 'Crop failed');
					}
					window.location.reload();
				}).catch(err => {
					alert(err.message);
				});
				return false;
			}


			function deleteUnreviewed(filename) {
				if (!confirm('Are you sure you want to delete this unreviewed signature?')) return;
				const data = new FormData();
				data.append('filename', filename);
				fetch('/unreviewed/delete', {
					method: 'POST',
					body: data
				}).then(async res => {
					if (!res.ok) {
						const payload = await res.json().catch(() => ({}));
						throw new Error(payload.error || 'Delete failed');
					}
					window.location.reload();
				}).catch(err => {
					alert(err.message);
				});
			}
			function remuxAllUnreviewed() {
				fetch('/api/unreviewed/remux-all', { method: 'POST' })
					.then(async res => {
						const data = await res.json().catch(() => ({}));
						if (!res.ok) throw new Error(data.error || 'Remux failed');
						alert(`Successfully remuxed ${data.count} chunks!`);
						window.location.reload();
					})
					.catch(err => alert(err.message));
			}
			function addCampaignPhrase(event, form) {
				event.preventDefault();
				const data = new FormData(form);
				fetch('/api/campaigns/phrases', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						campaign_artist: data.get('campaign_artist'),
						phrase: data.get('phrase')
					})
				}).then(async res => {
					if (!res.ok) {
						const payload = await res.json().catch(() => ({}));
						throw new Error(payload.error || 'Add phrase failed');
					}
					window.location.reload();
				}).catch(err => alert(err.message));
				return false;
			}
			function deleteCampaignPhrase(artist, phrase) {
				if (!confirm(`Are you sure you want to delete the phrase "${phrase}" for ${artist}?`)) return;
				fetch('/api/campaigns/phrases', {
					method: 'DELETE',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						campaign_artist: artist,
						phrase: phrase
					})
				}).then(async res => {
					if (!res.ok) {
						const payload = await res.json().catch(() => ({}));
						throw new Error(payload.error || 'Delete phrase failed');
					}
					window.location.reload();
				}).catch(err => alert(err.message));
			}
			function snapSubtitles(chunkName, word, timestampUnix, audioStartUnix, duration) {
				const editor = window.waveSurfers[chunkName];
				if (!editor || !editor.ws) return;
				
				// Add the word to the phrase input
				const phraseInput = document.getElementById('phrase-input-' + chunkName);
				if (phraseInput) {
					phraseInput.value = (phraseInput.value + ' ' + word).trim();
				}
				
				// Calculate relative time
				let relativeTime = timestampUnix - audioStartUnix;
				if (relativeTime < 0) relativeTime = 0;
				if (relativeTime > duration) relativeTime = duration;
				
				// Snap region boundaries (create a 2-second region around the word)
				const wsRegions = editor.ws.getActivePlugins().find(p => p.addRegion);
				if (wsRegions) {
					const regions = wsRegions.getRegions();
					if (regions.length > 0) {
						const region = regions[0];
						let start = relativeTime - 1.0;
						let end = relativeTime + 1.0;
						if (start < 0) start = 0;
						if (end > duration) end = duration;
						
						region.onResize(start - region.start, 'start');
						region.onResize(end - region.end, 'end');
					}
				}
			}
			function transcribeChunk(name, bucket, clickedButton) {
				const btn = clickedButton;
				const origText = btn.textContent;
				btn.textContent = 'Transcribing...';
				btn.disabled = true;
				
				fetch('/api/signatures/transcribe', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ filename: name, bucket: bucket })
				}).then(async res => {
					if (!res.ok) {
						const payload = await res.json().catch(() => ({}));
						throw new Error(payload.error || 'Transcription failed');
					}
					window.location.reload();
				}).catch(err => {
					alert(err.message);
					btn.textContent = origText;
					btn.disabled = false;
				});
			}

			window.waveSurfers = window.waveSurfers || {};
			window.initWaveformEditor = function(chunkName, url, duration) {
				const container = document.getElementById('editor-container-' + chunkName);
				document.getElementById('loader-btn-' + chunkName).style.display = 'none';
				container.classList.remove('hidden');
				
				const wsContainer = document.getElementById('waveform-' + chunkName);
				const ws = WaveSurfer.create({
					container: wsContainer,
					waveColor: 'rgba(255, 255, 255, 0.4)',
					progressColor: '#3b82f6',
					url: url,
					height: 120,
					autoScroll: true,
					autoCenter: true
				});
				
				const wsRegions = ws.registerPlugin(WaveSurfer.Regions.create());
				let currentRegion = null;
				
				ws.on('ready', () => {
					currentRegion = wsRegions.addRegion({
						start: 0,
						end: duration,
						color: 'rgba(59, 130, 246, 0.3)',
						resize: true,
						drag: true
					});
					
					currentRegion.on('update', () => {
						document.getElementById('start-input-' + chunkName).value = currentRegion.start;
						document.getElementById('start-val-' + chunkName).textContent = currentRegion.start.toFixed(2);
						document.getElementById('end-input-' + chunkName).value = currentRegion.end;
						document.getElementById('end-val-' + chunkName).textContent = currentRegion.end.toFixed(2);
					});
				});

				container.tabIndex = 0; // Make focusable for keyboard events
				container.addEventListener('keydown', (e) => {
					if (!currentRegion) return;
					if (e.code === 'Space') {
						e.preventDefault();
						ws.playPause();
					} else if (e.code === 'ArrowLeft') {
						e.preventDefault();
						if (e.shiftKey) currentRegion.onResize(-0.1, 'start');
						else currentRegion.onResize(-0.1, 'end');
					} else if (e.code === 'ArrowRight') {
						e.preventDefault();
						if (e.shiftKey) currentRegion.onResize(0.1, 'start');
						else currentRegion.onResize(0.1, 'end');
					}
				});
				
				window.waveSurfers[chunkName] = { ws, container };
			};

			window.toggleFullscreenEditor = function(chunkName) {
				const editor = window.waveSurfers[chunkName];
				if (!editor) return;
				const isFullscreen = editor.container.classList.contains('fixed');
				if (isFullscreen) {
					editor.container.classList.remove('fixed', 'inset-0', 'z-50', 'bg-black/95', 'p-8', 'flex', 'flex-col', 'justify-center');
					editor.container.classList.add('bg-black/30', 'p-2', 'mb-3');
				} else {
					editor.container.classList.remove('bg-black/30', 'p-2', 'mb-3');
					editor.container.classList.add('fixed', 'inset-0', 'z-50', 'bg-black/95', 'p-8', 'flex', 'flex-col', 'justify-center');
					editor.container.focus(); // Focus for keyboard shortcuts
				}
				// Force resize on WaveSurfer
				setTimeout(() => { editor.ws.drawBuffer(); }, 50);
			};

			window.playPauseWaveform = function(chunkName) {
				const editor = window.waveSurfers[chunkName];
				if (editor && editor.ws) editor.ws.playPause();
			};

			function showTab(tabName) {
				document.querySelectorAll('.matcher-tab-btn').forEach(btn => {
					if (btn.dataset.target === tabName) {
						btn.classList.add('text-primary');
						btn.classList.remove('text-muted');
					} else {
						btn.classList.add('text-muted');
						btn.classList.remove('text-primary');
					}
				});
				document.querySelectorAll('.matcher-tab-content').forEach(content => {
					content.style.display = content.id === 'tab-' + tabName ? 'block' : 'none';
				});
			}
			let stagedAudioFiles = [];
			let currentUploadMode = 'files';

			function setUploadMode(mode) {
				currentUploadMode = mode;
				const filesBtn = document.getElementById('upload-mode-files');
				const folderBtn = document.getElementById('upload-mode-folder');
				const label = document.getElementById('dropzone-label');
				const sublabel = document.getElementById('dropzone-sublabel');

				if (mode === 'files') {
					if (filesBtn) filesBtn.className = 'btn btn-sm btn-primary flex-1';
					if (folderBtn) folderBtn.className = 'btn btn-sm btn-secondary flex-1';
					if (label) label.textContent = 'Click to choose .ogg files (or drag & drop)';
					if (sublabel) sublabel.textContent = 'Multi-file selection active (files are selectable)';
				} else {
					if (folderBtn) folderBtn.className = 'btn btn-sm btn-primary flex-1';
					if (filesBtn) filesBtn.className = 'btn btn-sm btn-secondary flex-1';
					if (label) label.textContent = 'Click to choose a Folder (or drag & drop)';
					if (sublabel) sublabel.textContent = 'Folder mode active (all .ogg files inside folder extracted)';
				}
			}

			function triggerFilePicker() {
				if (currentUploadMode === 'files') {
					document.getElementById('audio-input-files').click();
				} else {
					document.getElementById('audio-input-folder').click();
				}
			}

			function handleFileSelection(event) {
				const files = Array.from(event.target.files || []);
				const oggs = files.filter(f => f.name.toLowerCase().endsWith('.ogg'));
				stagedAudioFiles = stagedAudioFiles.concat(oggs);
				updateSelectedUI();
			}

			function updateSelectedUI() {
				const selectedDiv = document.getElementById('dropzone-selected');
				const promptDiv = document.getElementById('dropzone-prompt');
				if (stagedAudioFiles.length > 0) {
					if (promptDiv) promptDiv.classList.add('hidden');
					if (selectedDiv) {
						selectedDiv.classList.remove('hidden');
						selectedDiv.textContent = `✓ ${stagedAudioFiles.length} .ogg voice note(s) staged for upload`;
					}
				} else {
					if (promptDiv) promptDiv.classList.remove('hidden');
					if (selectedDiv) selectedDiv.classList.add('hidden');
				}
			}

			function handleDragOver(event) {
				event.preventDefault();
				event.stopPropagation();
				const dz = document.getElementById('dropzone-area');
				if (dz) dz.style.borderColor = 'var(--primary)';
			}

			function handleDragLeave(event) {
				event.preventDefault();
				event.stopPropagation();
				const dz = document.getElementById('dropzone-area');
				if (dz) dz.style.borderColor = '';
			}

			async function handleDrop(event) {
				event.preventDefault();
				event.stopPropagation();
				const dz = document.getElementById('dropzone-area');
				if (dz) dz.style.borderColor = '';

				const items = event.dataTransfer.items;
				const newFiles = [];

				if (items && items.length > 0) {
					const entryPromises = [];
					for (let i = 0; i < items.length; i++) {
						const item = items[i];
						if (item.webkitGetAsEntry) {
							const entry = item.webkitGetAsEntry();
							if (entry) {
								entryPromises.push(traverseFileTree(entry, newFiles));
							}
						} else if (item.kind === 'file') {
							const file = item.getAsFile();
							if (file && file.name.toLowerCase().endsWith('.ogg')) {
								newFiles.push(file);
							}
						}
					}
					await Promise.all(entryPromises);
				} else if (event.dataTransfer.files) {
					const files = Array.from(event.dataTransfer.files);
					newFiles.push(...files.filter(f => f.name.toLowerCase().endsWith('.ogg')));
				}

				if (newFiles.length > 0) {
					stagedAudioFiles = stagedAudioFiles.concat(newFiles);
				}
				updateSelectedUI();
			}

			async function traverseFileTree(entry, fileList) {
				if (entry.isFile) {
					if (entry.name.toLowerCase().endsWith('.ogg')) {
						await new Promise(resolve => {
							entry.file(f => {
								fileList.push(f);
								resolve();
							});
						});
					}
				} else if (entry.isDirectory) {
					const dirReader = entry.createReader();
					const entries = await readAllEntries(dirReader);
					for (const child of entries) {
						await traverseFileTree(child, fileList);
					}
				}
			}

			function readAllEntries(dirReader) {
				return new Promise(resolve => {
					let entries = [];
					function read() {
						dirReader.readEntries(results => {
							if (!results || !results.length) {
								resolve(entries);
							} else {
								entries = entries.concat(Array.from(results));
								read();
							}
						}, () => resolve(entries));
					}
					read();
				});
			}

			function uploadAudio(event, form) {
				event.preventDefault();
				const result = document.getElementById('upload-audio-result');

				if (stagedAudioFiles.length === 0) {
					const filesInput = document.getElementById('audio-input-files');
					const folderInput = document.getElementById('audio-input-folder');
					const rawFiles = [];
					if (filesInput && filesInput.files) rawFiles.push(...Array.from(filesInput.files));
					if (folderInput && folderInput.files) rawFiles.push(...Array.from(folderInput.files));
					stagedAudioFiles = rawFiles.filter(f => f.name.toLowerCase().endsWith('.ogg'));
				}

				if (stagedAudioFiles.length === 0) {
					result.textContent = 'Please select or drag & drop at least one .ogg voice note file or folder.';
					result.className = 'mt-4 text-sm text-warning';
					return false;
				}

				const data = new FormData();
				data.append('person_slug', form.person_slug.value);
				for (const file of stagedAudioFiles) {
					data.append('audio', file, file.name);
				}

				result.textContent = `Uploading ${stagedAudioFiles.length} file(s)...`;
				result.className = 'mt-4 text-sm text-muted';

				fetch('/api/audio/upload', {
					method: 'POST',
					body: data
				}).then(async res => {
					const text = await res.text();
					result.textContent = text;
					result.className = res.ok ? 'mt-4 text-sm text-success' : 'mt-4 text-sm text-warning';
					if (!res.ok) {
						throw new Error(text || 'Upload failed');
					}
					stagedAudioFiles = [];
					form.reset();
					const filesInput = document.getElementById('audio-input-files');
					const folderInput = document.getElementById('audio-input-folder');
					if (filesInput) filesInput.value = '';
					if (folderInput) folderInput.value = '';
					updateSelectedUI();
				}).catch(err => {
					result.textContent = err.message || 'Upload failed';
					result.className = 'mt-4 text-sm text-warning';
				});
				return false;
			}
			function saveSchedule(event, form) {
				event.preventDefault();
				const raw = form.target_matches.value.trim();
				const result = document.getElementById('schedule-result');
				const values = raw === '' ? [] : raw.split(',').map(part => part.trim()).filter(Boolean);
				const matches = [];
				for (const value of values) {
					const parsed = Number.parseInt(value, 10);
					if (!Number.isInteger(parsed)) {
						result.textContent = 'Target matches must be a comma-separated list of integers.';
						result.className = 'mt-4 text-sm text-warning';
						return false;
					}
					matches.push(parsed);
				}

				result.textContent = 'Saving...';
				result.className = 'mt-4 text-sm text-muted';
				fetch('/api/schedule', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						date: form.date.value,
						target_matches: matches
					})
				}).then(async res => {
					const payload = await res.json().catch(() => ({}));
					if (!res.ok) {
						throw new Error(payload.error || 'Save failed');
					}
					result.textContent = 'Schedule saved.';
					result.className = 'mt-4 text-sm text-success';
					window.location.reload();
				}).catch(err => {
					result.textContent = err.message;
					result.className = 'mt-4 text-sm text-warning';
				});
				return false;
			}
			function fillAllSchedules() {
				const result = document.getElementById('schedule-result');
				result.textContent = 'Filling all campaign days with 1,2,3,4,5,6...';
				result.className = 'mt-4 text-sm text-muted';
				fetch('/api/schedule', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						date: '*',
						target_matches: [1, 2, 3, 4, 5, 6]
					})
				}).then(async res => {
					const payload = await res.json().catch(() => ({}));
					if (!res.ok) {
						throw new Error(payload.error || 'Fill failed');
					}
					result.textContent = `Updated ${payload.updated_days} campaign days to 1, 2, 3, 4, 5, 6.`;
					result.className = 'mt-4 text-sm text-success';
					window.location.reload();
				}).catch(err => {
					result.textContent = err.message;
					result.className = 'mt-4 text-sm text-warning';
				});
			}
			function toggleKillSwitch(active) {
				const pw = prompt(active ? "⚠️ DANGER! Enter Admin Password to permanently disable the bot:" : "Enter Admin Password to re-enable the bot:");
				if (!pw) return;
				fetch('/api/kill-switch', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ password: pw, active: active })
				}).then(res => {
					if (!res.ok) alert("Invalid password or server error");
				});
			}

			document.addEventListener("DOMContentLoaded", function() {
				// Initialize the ticking clock using the server's time
				const timeEl = document.getElementById('server-time');
				let currentServerMs = parseInt(timeEl.getAttribute('data-server-time'), 10);
				setInterval(() => {
					currentServerMs += 1000;
					const d = new Date(currentServerMs);
					timeEl.innerText = d.toLocaleTimeString('ro-RO');
				}, 1000);
			});
		</script>
		<div class="container" hx-ext="sse" sse-connect="/events/dashboard">
			if state.HasMegaCriticalAlert {
				<div class="bg-danger/20 border-2 border-danger text-danger p-4 rounded-xl mb-6 flex items-center justify-between animate-pulse">
					<div class="flex items-center gap-3">
						<span class="text-2xl">🚨</span>
						<div>
							<div class="font-bold">MEGA CRITICAL ALERT: No People Configured!</div>
							<div class="text-xs">You have connected WhatsApp phones but zero registered Persons. Contest voicenotes cannot be sent until a Person is created and phones are assigned.</div>
						</div>
					</div>
					<button onclick="document.getElementById('create-person-form').scrollIntoView({behavior: 'smooth'})" class="btn btn-danger btn-sm">Create Person Now</button>
				</div>
			} else if state.UnassignedPhonesCount > 0 {
				<div class="bg-warning/20 border-2 border-warning text-warning p-4 rounded-xl mb-6 flex items-center justify-between">
					<div class="flex items-center gap-3">
						<span class="text-2xl">⚠️</span>
						<div>
							<div class="font-bold">Unassigned WhatsApp Phone(s) Detected!</div>
							<div class="text-xs">{ fmt.Sprintf("%d", state.UnassignedPhonesCount) } connected phone(s) are not assigned to any Person. Assign them in the People section below so their voice note pools can be used.</div>
						</div>
					</div>
					<button onclick="document.getElementById('people-section').scrollIntoView({behavior: 'smooth'})" class="btn btn-warning btn-sm">Review Senders</button>
				</div>
			}

			<header class="header flex justify-between items-center">
				<h1 class="title m-0">🐆 Telemetrie pe ProFM, Jaguare</h1>
				<div class="flex items-center gap-4">
					<div class="text-sm font-mono bg-black/20 px-3 py-1 rounded border border-white/10" id="server-time" data-server-time={ fmt.Sprintf("%d", time.Now().UnixMilli()) }>
						{ time.Now().Format("15:04:05") }
					</div>
					<div class="flex gap-2">
						<button onclick="toggleGathering()" class="btn btn-secondary btn-sm">Toggle Gathering</button>
						<button onclick="toggleKillSwitch(true)" class="btn btn-danger btn-sm">🏆 I WON (KILL BOT)</button>
						<button onclick="toggleKillSwitch(false)" class="btn btn-secondary btn-sm">UNDO KILL</button>
						<a href="/data" class="btn btn-secondary btn-sm">Files</a>
						<a href="/radio-logs" class="btn btn-secondary btn-sm">Radio History</a>
						<a href="/alerts" class="btn btn-secondary btn-sm">Alerts</a>
						<a href="/logs" class="btn btn-secondary btn-sm">Logs</a>
						<a href="/logout" class="btn btn-secondary btn-sm">Logout</a>
					</div>
				</div>
			</header>

			<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
				<!-- Left Column: Status & Stats -->
				<div class="space-y-6 col-span-2">
					<!-- State Machine Status -->
					<div class="glass" id="status-card" sse-swap="status">
						@StatusComponent(state)
					</div>

					<!-- Current Song -->
					<div class="glass" id="song-card" sse-swap="song">
						@SongComponent(state.CurrentSong)
					</div>

					<!-- Audio Stats -->
					<div class="glass flex justify-between" id="audio-card" sse-swap="audio">
						@AudioStatsComponent(state)
					</div>

					<!-- People & WhatsApp Senders -->
					<div class="glass p-6" id="people-section">
						<div class="flex justify-between items-center mb-6">
							<div>
								<h2 class="text-lg font-bold flex items-center gap-2 text-white">👥 People & WhatsApp Senders</h2>
								<div class="text-xs text-muted mt-0.5">Each person owns a dedicated voice note pool. All phones assigned to a person draw from that pool.</div>
							</div>
							<button onclick="document.getElementById('modal-add-person').classList.toggle('hidden')" class="btn btn-primary btn-sm flex items-center gap-1 font-semibold">
								<span>+</span> Add New Person
							</button>
						</div>

						<div id="modal-add-person" class="hidden mb-6 p-5 rounded-2xl bg-black/40 border border-primary/30 shadow-lg">
							<div class="font-bold text-sm mb-3 text-primary flex items-center gap-1.5">
								<span>✨</span> Create New Person
							</div>
							<form id="create-person-form" onsubmit="return createPerson(event, this)" class="flex flex-col sm:flex-row gap-3 items-end">
								<div class="flex-grow w-full">
									<label class="text-xs text-muted mb-1 block">Person Full Name</label>
									<input type="text" name="name" placeholder="e.g. Victor Stan" class="input w-full" required />
								</div>
								<div class="flex gap-2 w-full sm:w-auto">
									<button type="submit" class="btn btn-primary btn-sm flex-1 sm:flex-initial">Save Person</button>
									<button type="button" onclick="document.getElementById('modal-add-person').classList.add('hidden')" class="btn btn-secondary btn-sm flex-1 sm:flex-initial">Cancel</button>
								</div>
							</form>
						</div>

						if len(persons) == 0 {
							<div class="text-center py-10 text-muted border-2 border-dashed border-white/10 rounded-2xl bg-white/[0.02]">
								<p class="text-base font-semibold text-white/80 mb-1">No people registered yet</p>
								<p class="text-xs text-muted mb-4">Create a person profile to assign connected WhatsApp numbers and upload voice notes.</p>
								<button onclick="document.getElementById('modal-add-person').classList.remove('hidden')" class="btn btn-primary btn-sm">Create First Person</button>
							</div>
						} else {
							<div class="space-y-6">
								for _, p := range persons {
									<div class="border border-white/10 rounded-2xl p-5 bg-black/30 shadow-sm transition-all hover:border-white/20">
										<!-- Person Header -->
										<div class="flex flex-wrap justify-between items-start gap-4 mb-4 pb-4 border-b border-white/10">
											<div>
												<div class="flex items-center gap-3">
													<h3 class="text-lg font-bold text-white tracking-tight">{ p.Name }</h3>
													<span class="text-xs font-mono bg-primary/15 text-primary border border-primary/30 px-2.5 py-0.5 rounded-full">{ p.Slug }</span>
												</div>
												<div class="text-xs text-muted mt-1 flex items-center gap-2">
													<span>Created: { p.CreatedAt.Format("02 Jan 2006 15:04") }</span>
												</div>
											</div>
											<div class="flex items-center gap-2">
												<button type="button" onclick={ templ.ComponentScript{Call: fmt.Sprintf("editPerson(%d, '%s')", p.ID, p.Name)} } class="btn btn-secondary btn-sm text-xs py-1.5 px-3">Edit Name</button>
												<button type="button" onclick={ templ.ComponentScript{Call: fmt.Sprintf("deletePerson(%d, '%s')", p.ID, p.Name)} } class="btn btn-danger btn-sm text-xs py-1.5 px-3">Delete</button>
											</div>
										</div>

										<!-- Assigned Phones Sub-section -->
										<div class="mb-5">
											<div class="text-xs uppercase text-muted tracking-wider font-semibold mb-2.5 flex items-center gap-1.5">
												<span>📱</span> Assigned WhatsApp Numbers:
											</div>
											<div class="flex flex-wrap gap-3">
												for _, conn := range state.Connections {
													if conn.PersonSlug == p.Slug || (conn.PersonID != nil && *conn.PersonID == p.ID) {
														<div class="flex items-center gap-2.5 bg-white/5 hover:bg-white/10 border border-white/15 rounded-xl px-3.5 py-2 text-sm shadow-sm transition-colors">
															if conn.Status == StatusConnected {
																<span class="w-2.5 h-2.5 rounded-full bg-success inline-block shadow-sm shadow-success/50" title="Connected"></span>
															} else if conn.Status == StatusPairingRequired {
																<span class="w-2.5 h-2.5 rounded-full bg-warning inline-block shadow-sm shadow-warning/50" title="Pairing Required"></span>
															} else {
																<span class="w-2.5 h-2.5 rounded-full bg-danger inline-block shadow-sm shadow-danger/50" title="Disconnected / Error"></span>
															}
															<span class="font-mono font-medium text-white/90">{ conn.Phone }</span>
															<select onchange={ templ.ComponentScript{Call: fmt.Sprintf("assignPhone('%s', this.value)", conn.Phone)} } class="bg-black/50 text-white rounded-lg px-2.5 py-1 text-xs border border-white/20 focus:outline-none focus:border-primary cursor-pointer">
																<option value={ fmt.Sprintf("%d", p.ID) } selected>{ p.Name }</option>
																for _, other := range persons {
																	if other.ID != p.ID {
																		<option value={ fmt.Sprintf("%d", other.ID) }>{ other.Name }</option>
																	}
																}
																<option value="0">Unassign</option>
															</select>
															<button type="button" hx-post="/api/sender/disconnect" hx-vals={ fmt.Sprintf(`{"phone": "%s"}`, conn.Phone) } hx-target="#qr-card" hx-swap="innerHTML" class="text-danger hover:text-danger/80 text-sm font-bold ml-1 p-1 hover:bg-danger/10 rounded" title="Disconnect Phone">✕</button>
														</div>
													}
												}
											</div>
										</div>

										<!-- Audio Pool & Batch Move -->
										<div class="pt-2">
											<div class="flex flex-wrap items-center justify-between gap-3 mb-3 p-3 rounded-xl bg-white/[0.03] border border-white/10">
												<div class="text-xs text-muted flex items-center gap-2">
													<span>🎵 Audio Pool:</span>
													<span class="bg-success/15 text-success font-semibold px-2 py-0.5 rounded-full border border-success/30">{ fmt.Sprintf("%d active", len(personAudios[p.Slug].Active)) }</span>
													<span class="bg-white/10 text-muted px-2 py-0.5 rounded-full">{ fmt.Sprintf("%d used", len(personAudios[p.Slug].Used)) }</span>
												</div>
												if len(personAudios[p.Slug].Active) > 0 && len(persons) > 1 {
													<div class="flex items-center gap-2">
														<label class="text-xs text-muted flex items-center gap-1.5 cursor-pointer select-none bg-black/40 px-2.5 py-1 rounded-lg border border-white/10">
															<input type="checkbox" onchange={ templ.ComponentScript{Call: fmt.Sprintf("toggleSelectAllAudios('%s', this.checked)", p.Slug)} } class="rounded border-white/20" />
															<span>Select All</span>
														</label>
														<select id={ "target-person-" + p.Slug } class="bg-black/50 text-white rounded-lg px-2.5 py-1 text-xs border border-white/20 focus:outline-none focus:border-primary">
															<option value="" disabled selected>Move selected to...</option>
															for _, other := range persons {
																if other.Slug != p.Slug {
																	<option value={ other.Slug }>{ other.Name }</option>
																}
															}
														</select>
														<button type="button" onclick={ templ.ComponentScript{Call: fmt.Sprintf("batchMoveAudios('%s')", p.Slug)} } class="btn btn-primary btn-sm py-1 px-3 text-xs font-semibold flex items-center gap-1">🚚 Move</button>
													</div>
												}
											</div>

											if len(personAudios[p.Slug].Active) > 0 {
												<div class="max-h-64 overflow-y-auto space-y-1.5 bg-black/40 rounded-xl p-2.5 border border-white/10">
													for _, f := range personAudios[p.Slug].Active {
														<div class="flex items-center justify-between gap-3 p-2 rounded-lg hover:bg-white/5 border border-transparent hover:border-white/10 transition-colors">
															<label class="flex items-center gap-3 cursor-pointer flex-grow min-w-0">
																<input type="checkbox" class={ "audio-checkbox-" + p.Slug + " rounded border-white/20 text-primary focus:ring-0" } value={ f } />
																<span class="text-xs font-mono text-white/90 truncate" title={ f }>{ f }</span>
															</label>
															<div class="flex items-center gap-2 shrink-0">
																<audio controls preload="none" class="h-7 w-48 opacity-80 hover:opacity-100 transition-opacity" src={ fmt.Sprintf("/api/audio/play?slug=%s&file=%s", p.Slug, url.QueryEscape(f)) }></audio>
															</div>
														</div>
													}
												</div>
											} else {
												<div class="text-xs text-muted italic p-3 bg-black/20 rounded-xl border border-dashed border-white/10 text-center">No active voice notes uploaded for { p.Name }.</div>
											}
										</div>
									</div>
								}
							</div>
						}
					</div>

					<div class="glass p-6" id="matcher-data">
						<div class="flex justify-between items-center mb-4">
							<div>
								<h2 class="text-sm uppercase text-muted mb-1">Matcher-related data</h2>
								if state.GatheringSignatures {
									<div class="text-sm text-success">Gathering enabled</div>
								} else {
									<div class="text-sm text-warning">Gathering disabled</div>
								}
							</div>
							<div class="flex gap-2">
								<button onclick="remuxAllUnreviewed()" class="btn btn-primary btn-sm">Fix Infinite Audios</button>
								<a href="/api/unreviewed" class="btn btn-secondary btn-sm" target="_blank">List JSON</a>
							</div>
						</div>

						<div class="flex gap-2 border-b border-white/10 mb-6 pb-0">
							<button class="matcher-tab-btn font-semibold text-primary" data-target="fingerprint" onclick="showTab('fingerprint')">Unreviewed Signatures</button>
							<button class="matcher-tab-btn font-semibold text-muted" data-target="canonical" onclick="showTab('canonical')">Canonical Signatures</button>
							<button class="matcher-tab-btn font-semibold text-muted" data-target="transcription" onclick="showTab('transcription')">Transcription Phrases</button>
						</div>

						<div id="tab-fingerprint" class="matcher-tab-content">
							if len(chunks) == 0 {
								<div class="text-sm text-muted">No unreviewed chunks waiting for manual review.</div>
							} else {
								<div class="space-y-4">
									for _, chunk := range chunks {
										<div class="border border-white/10 rounded p-4">
											<div class="flex justify-between items-center gap-4 mb-3">
												<div>
													<div class="font-semibold break-all">{ chunk.Name }</div>
													<div class="text-xs text-muted mb-2">{ fmt.Sprintf("%.2f MB", float64(chunk.Size)/(1024*1024)) } ({ fmt.Sprintf("%.0fs", chunk.DurationSeconds) }) · { chunk.ModTime.Format("2006-01-02 15:04:05") }</div>
													if len(chunk.ParsedTags) > 0 {
														<div class="text-xs border border-white/10 bg-black/40 p-2 rounded">
															<div class="font-medium text-primary mb-1">Diagnostic Context:</div>
															for i, tag := range chunk.ParsedTags {
																<div class="mb-1">
																	if i == 0 {
																		<strong>Winner:</strong> { tag.Source } 
																		if tag.Source == triggerSourceTranscription {
																			("{ tag.Phrase }")
																		} else if tag.Source == triggerSourceFingerprint {
																			("{ tag.SignatureName }")
																		} else {
																			("{ tag.CampaignArtist }")
																		}
																	} else {
																		<strong>Late Matcher:</strong> { tag.Source }
																		if tag.Source == triggerSourceTranscription {
																			("{ tag.Phrase }")
																		} else if tag.Source == triggerSourceFingerprint {
																			("{ tag.SignatureName }")
																		}
																	}
																</div>
															}
														</div>
													}
												</div>
												<div class="flex gap-2">
													<a href={ templ.URL(chunk.PlayURL) } target="_blank" class="btn btn-secondary btn-sm">Open</a>
													<button type="button" class="btn btn-danger btn-sm" onclick={ templ.ComponentScript{Call: fmt.Sprintf("deleteUnreviewed('%s')", chunk.Name)} }>Delete</button>
												</div>
											</div>
											<div id={ "editor-container-" + chunk.Name } class="w-full bg-black/30 rounded p-2 mb-3 hidden">
												<div id={ "waveform-" + chunk.Name } class="w-full h-24 mb-2"></div>
												
												<form id={ "form-crop-" + chunk.Name } onsubmit="return cropUnreviewed(event, this)" class="flex flex-col gap-2">
													<input type="hidden" name="filename" value={ chunk.Name }/>
													<input type="hidden" name="start_seconds" id={ "start-input-" + chunk.Name } value="0"/>
													<input type="hidden" name="end_seconds" id={ "end-input-" + chunk.Name } value={ fmt.Sprintf("%.1f", chunk.DurationSeconds) }/>
													
													<div class="flex justify-between items-center text-xs text-muted mb-2">
														<div>Start: <span id={ "start-val-" + chunk.Name }>0.00</span>s</div>
														<div>End: <span id={ "end-val-" + chunk.Name }>{ fmt.Sprintf("%.2f", chunk.DurationSeconds) }</span>s</div>
													</div>
													
													<div class="flex flex-col gap-2 mt-2">
														<input type="text" name="save_phrase" id={ "phrase-input-" + chunk.Name } placeholder="Click subtitles to build phrase, or type here..." class="input w-full" />
														
														<div class="flex justify-between">
															<div class="flex gap-2">
																<button type="button" class="btn btn-secondary btn-sm"
																	data-name={ chunk.Name }
																	onclick="window.playPauseWaveform(this.dataset.name)">Play / Pause</button>
																<button type="button" class="btn btn-secondary btn-sm"
																	data-name={ chunk.Name }
																	onclick="window.toggleFullscreenEditor(this.dataset.name)">⛶ Fullscreen</button>
															</div>
															<div class="flex gap-2">
																<button type="submit" class="btn btn-primary btn-sm bg-success/80 border-success hover:bg-success">Crop &amp; Save</button>
															</div>
														</div>
													</div>
												</form>
											</div>
											
											<div id={ "loader-btn-" + chunk.Name } class="flex justify-center mb-3">
												<button type="button" class="btn btn-secondary btn-sm w-full py-4 bg-black/20"
													data-name={ chunk.Name }
													data-url={ chunk.PlayURL }
													data-duration={ fmt.Sprintf("%f", chunk.DurationSeconds) }
													onclick="window.initWaveformEditor(this.dataset.name, this.dataset.url, parseFloat(this.dataset.duration))">
													🎙️ Load Audio Editor
												</button>
											</div>

											if len(chunk.ParsedTranscripts) > 0 {
												<div class="bg-black/20 p-3 rounded font-mono text-sm border-l-2 border-primary">
													<div class="text-xs text-muted mb-1 uppercase tracking-wider">Transcription:</div>
													<div class="flex flex-wrap gap-1">
														for _, t := range chunk.ParsedTranscripts {
															<span class={
																"px-1 rounded cursor-pointer hover:bg-white/20 transition-colors",
																templ.KV("bg-warning/30 text-warning", isWordHighlighted(t.Value, chunk.ParsedTags)),
															}
															title={ fmt.Sprintf("Snap to %s", t.Timestamp.Format("15:04:05")) }
															onclick={ templ.ComponentScript{Call: fmt.Sprintf("snapSubtitles('%s', '%s', %d, %d, %f)", chunk.Name, templateSafe(t.Value), t.Timestamp.Unix(), chunk.ModTime.Unix() - int64(chunk.DurationSeconds), chunk.DurationSeconds)} }>{ t.Value }</span>
														}
													</div>
												</div>
											} else {
												<div class="flex items-center justify-between gap-4 bg-black/10 p-3 rounded">
													<div class="text-xs text-muted italic">No transcription available.</div>
													<button type="button" class="btn btn-secondary btn-sm"
														data-name={ chunk.Name }
														data-bucket="unreviewed"
												onclick="window.transcribeChunk(this.dataset.name, this.dataset.bucket, this)">Transcribe</button>
												</div>
											}
										</div>
									}
								</div>
							}
						</div>

						<div id="tab-transcription" class="matcher-tab-content" style="display: none;">
							<div class="border border-white/10 rounded p-4 mb-6 bg-black/20">
								<div class="font-semibold text-sm mb-2 text-primary">Add Manual Phrase</div>
								<form onsubmit="return addCampaignPhrase(event, this)" class="flex gap-2 items-end">
									<div class="flex-grow flex gap-2">
										<select name="campaign_artist" class="input flex-grow" required>
											<option value="" disabled selected>Select Campaign Artist...</option>
											for _, artist := range campaignArtists {
												<option value={ artist }>{ artist }</option>
											}
										</select>
										<input type="text" name="phrase" placeholder="Phrase text..." class="input flex-grow" required />
									</div>
									<button type="submit" class="btn btn-primary btn-sm whitespace-nowrap">Add Phrase</button>
								</form>
							</div>

							<div class="border border-white/10 rounded p-4 mb-6 bg-black/20">
								<div class="font-semibold text-sm mb-2 text-primary">Existing Manual Phrases</div>
								if len(campaignPhrases) == 0 {
									<div class="text-xs text-muted">No manual phrases saved yet.</div>
								} else {
									<div class="space-y-3">
										for artist, phrases := range campaignPhrases {
											<div>
												<div class="text-xs font-semibold uppercase text-muted mb-1">{ artist }</div>
												<div class="flex flex-wrap gap-2">
													for _, phrase := range phrases {
														<div class="flex items-center gap-1 bg-black/40 border border-white/10 rounded px-2 py-1 text-sm">
															<span>{ phrase }</span>
															<button type="button" class="text-danger hover:text-danger/80 ml-1 font-bold" title="Delete Phrase"
																onclick={ templ.ComponentScript{Call: fmt.Sprintf("deleteCampaignPhrase('%s', '%s')", artist, phrase)} }>✕</button>
														</div>
													}
												</div>
											</div>
										}
									</div>
								}
							</div>

							if len(chunks) == 0 {
								<div class="text-sm text-muted">No transcriptions waiting for manual review.</div>
							} else {
								<div class="space-y-4">
									for _, chunk := range chunks {
										if len(chunk.ParsedTranscripts) > 0 {
											<div class="border border-white/10 rounded p-4 mb-3">
												<div class="font-semibold text-sm mb-2">Audio: { chunk.Name }</div>
												<div class="bg-black/20 p-3 rounded font-mono text-sm mb-3">
													<div class="flex flex-wrap gap-1">
														for _, t := range chunk.ParsedTranscripts {
															<span class="px-1 rounded">{ t.Value }</span>
														}
													</div>
												</div>
												<form onsubmit="return addCampaignPhrase(event, this)" class="flex gap-2 items-end">
													<select name="campaign_artist" class="input flex-grow" required>
														if chunk.CampaignArtist == "" {
															<option value="" disabled selected>Select Campaign Artist...</option>
														}
														for _, artist := range campaignArtists {
															<option value={ artist } selected?={ strings.EqualFold(artist, chunk.CampaignArtist) }>{ artist }</option>
														}
													</select>
													<input type="text" name="phrase" class="input flex-grow" required />
													<button type="submit" class="btn btn-primary btn-sm">Add Phrase</button>
												</form>
											</div>
										}
									}
								</div>
							}
						</div>

						<div id="tab-canonical" class="matcher-tab-content" style="display: none;">
							if len(canonicalChunks) == 0 {
								<div class="text-sm text-muted">No canonical signatures exist yet.</div>
							} else {
								<div class="space-y-4">
									for _, chunk := range canonicalChunks {
										<div class="border border-white/10 rounded p-4 mb-3">
											<div class="flex justify-between items-center gap-4 mb-3">
												<div>
													<div class="font-semibold break-all">{ chunk.Name }</div>
													<div class="text-xs text-muted">{ fmt.Sprintf("%.2f MB", float64(chunk.Size)/(1024*1024)) } ({ fmt.Sprintf("%.0fs", chunk.DurationSeconds) }) · { chunk.ModTime.Format("2006-01-02 15:04:05") }</div>
												</div>
												<div class="flex gap-2">
													<a href={ templ.URL(chunk.PlayURL) } target="_blank" class="btn btn-secondary btn-sm">Listen</a>
												</div>
											</div>
											if len(chunk.ParsedTranscripts) > 0 {
												<div class="bg-black/20 p-3 rounded font-mono text-sm border-l-2 border-primary">
													<div class="text-xs text-muted mb-1 uppercase tracking-wider">Transcription:</div>
													<div class="flex flex-wrap gap-1">
														for _, t := range chunk.ParsedTranscripts {
															<span class="px-1 rounded">{ t.Value }</span>
														}
													</div>
												</div>
											} else {
												<div class="flex items-center justify-between gap-4 bg-black/10 p-3 rounded">
													<div class="text-xs text-muted italic">No transcription available.</div>
													<button type="button" class="btn btn-secondary btn-sm"
														data-name={ chunk.Name }
														data-bucket="canonical"
												onclick="window.transcribeChunk(this.dataset.name, this.dataset.bucket, this)">Transcribe</button>
												</div>
											}
										</div>
									}
								</div>
							}
						</div>
					</div>
				</div>

				<!-- Right Column: QR Code & Logs -->
				<div class="space-y-6">
					<div id="qr-card" sse-swap="qrcode">
						@QRComponent(state.Connections)
					</div>

					<div class="glass p-6">
						<h2 class="text-sm uppercase text-muted mb-2">Pair WhatsApp Phone</h2>
						<p class="text-xs text-muted mb-4">Select who this WhatsApp number belongs to before generating the QR code.</p>
						<form hx-post="/api/sender/add" hx-target="#add-sender-result" hx-swap="innerHTML" class="space-y-3">
							<div>
								<label class="text-xs text-muted mb-1">Assign to Person</label>
								<select name="person_id" class="input" required>
									if len(persons) == 0 {
										<option value="" disabled selected>-- Create a Person first! --</option>
									} else {
										<option value="" disabled selected>-- Select Person --</option>
										for _, p := range persons {
											<option value={ fmt.Sprintf("%d", p.ID) }>{ p.Name }</option>
										}
									}
								</select>
							</div>
							<button type="submit" class="btn btn-secondary w-full" disabled?={ len(persons) == 0 }>Generate Pairing QR Code</button>
						</form>
						<div id="add-sender-result" class="mt-4 text-sm text-warning"></div>
					</div>

					<div class="glass p-6">
						<h2 class="text-sm uppercase text-muted mb-4">Upload Voice Note</h2>
						<form onsubmit="return uploadAudio(event, this)" class="space-y-4">
							<div>
								<label class="text-xs text-muted mb-1">Target Person</label>
								<select name="person_slug" class="input" required>
									if len(persons) == 0 {
										<option value="" disabled selected>-- Create a Person first! --</option>
									} else {
										for _, p := range persons {
											<option value={ p.Slug }>{ p.Name } ({ p.Slug })</option>
										}
									}
								</select>
							</div>

							<div>
								<label class="text-xs text-muted mb-1">.ogg voice note (files or folders)</label>
								<div class="flex gap-2 mb-2">
									<button type="button" id="upload-mode-files" class="btn btn-sm btn-primary flex-1" onclick="setUploadMode('files')">Files Mode</button>
									<button type="button" id="upload-mode-folder" class="btn btn-sm btn-secondary flex-1" onclick="setUploadMode('folder')">Folder Mode</button>
								</div>

								<div id="dropzone-area" 
									 class="border-2 border-dashed border-white/20 rounded-xl p-4 text-center cursor-pointer transition-colors"
									 onclick="triggerFilePicker()"
									 ondragover="handleDragOver(event)"
									 ondragleave="handleDragLeave(event)"
									 ondrop="handleDrop(event)">
									
									<input type="file" id="audio-input-files" accept=".ogg,audio/ogg" class="hidden" multiple onchange="handleFileSelection(event)" />
									<input type="file" id="audio-input-folder" class="hidden" webkitdirectory directory onchange="handleFileSelection(event)" />

									<div id="dropzone-prompt" class="space-y-1">
										<div class="text-sm font-medium" id="dropzone-label">Click to choose .ogg files (or drag & drop)</div>
										<div class="text-xs text-muted" id="dropzone-sublabel">Multi-file selection active (files are selectable)</div>
									</div>
									<div id="dropzone-selected" class="hidden text-sm text-success font-medium"></div>
								</div>
							</div>

							<button type="submit" class="btn btn-primary">Upload</button>
						</form>
						<div id="upload-audio-result" class="mt-4 text-sm text-muted">Uploads land in the active pool, never in <code>used/</code>.</div>
					</div>

					<div class="glass p-6">
						<div class="flex justify-between items-center mb-4">
							<div>
								<h2 class="text-sm uppercase text-muted mb-1">Daily RNG Schedule</h2>
								<div class="text-xs text-muted">Edit the stored daily match indices used by the RNG gate.</div>
							</div>
							<a href="/api/schedule" class="btn btn-secondary btn-sm" target="_blank">JSON</a>
						</div>
						<form onsubmit="return saveSchedule(event, this)" class="space-y-4">
							<div>
								<label class="text-xs text-muted mb-1">Date</label>
								<input type="date" name="date" class="input" required />
							</div>
							<div>
								<label class="text-xs text-muted mb-1">Target matches</label>
								<input type="text" name="target_matches" placeholder="1,3,5" class="input" required />
							</div>
							<div class="flex gap-2">
								<button type="submit" class="btn btn-primary">Save Schedule</button>
								<button type="button" class="btn btn-secondary" onclick="fillAllSchedules()">All 6/6</button>
							</div>
						</form>
						<div id="schedule-result" class="mt-4 text-sm text-muted">Use comma-separated match indices such as <code>1, 3, 5</code>.</div>
						if len(schedules) == 0 {
							<div class="mt-4 text-sm text-muted">No schedules stored yet.</div>
						} else {
							<div class="mt-4 space-y-2 max-h-72 overflow-y-auto">
								for _, schedule := range schedules {
									<div class="border border-white/10 rounded p-3">
										<div class="text-sm font-semibold">{ schedule.Date }</div>
										<div class="text-xs text-muted">Target matches: { formatScheduleTargets(schedule.TargetMatches) }</div>
									</div>
								}
							</div>
						}
					</div>
				</div>
			</div>
		</div>
	}
}

templ StatusComponent(state AppState) {
	<h2 class="text-sm uppercase text-muted mb-2">System Status</h2>
	<div class="flex items-center space-x-3">
		if state.Status == StatusConnected || state.Status == StatusPolling {
			<span class="status-indicator status-success">
			  <span class="status-ping"></span>
			  <span class="status-dot"></span>
			</span>
			<span class="text-2xl font-semibold text-success">{ string(state.Status) }</span>
		} else if state.Status == StatusPairingRequired {
			<span class="status-indicator status-warning">
			  <span class="status-ping"></span>
			  <span class="status-dot"></span>
			</span>
			<span class="text-2xl font-semibold text-warning">{ string(state.Status) }</span>
		} else if state.Status == StatusKilled {
			<span class="text-3xl font-black text-warning tracking-widest text-center block w-full py-6">
			  🎉 WINNER! BOT IS PERMANENTLY DISABLED
			</span>
		} else if state.Status == StatusError || state.Status == StatusAudioExhausted {
			<span class="status-indicator status-danger">
			  <span class="status-ping"></span>
			  <span class="status-dot"></span>
			</span>
			<span class="text-2xl font-semibold text-danger">{ string(state.Status) }</span>
		} else if state.Status == StatusSleeping {
			<span class="status-indicator status-neutral">
			  <span class="status-dot"></span>
			</span>
			<span class="text-2xl font-semibold text-muted">{ string(state.Status) }</span>
		} else {
			<span class="status-indicator status-neutral">
			  <span class="status-dot"></span>
			</span>
			<span class="text-2xl font-semibold text-muted">{ string(state.Status) }</span>
		}
	</div>
	if state.LastError != "" {
		<div class="error-box">
			{ state.LastError }
		</div>
	}
}

templ SongComponent(song string) {
	<h2 class="text-sm uppercase text-muted mb-2">Acum joaca:</h2>
	if song == "" {
		<div class="text-xl text-muted italic">Waiting for broadcast...</div>
	} else {
		<div class="text-2xl font-bold">{ song }</div>
	}
}

templ AudioStatsComponent(state AppState) {
	<div class="w-full">
		<div class="flex justify-between mb-4 border-b border-white/10 pb-4">
			<div class="flex-grow">
				<h2 class="text-sm uppercase text-muted mb-2">Total Unused Audios</h2>
				<div class="text-3xl font-bold text-success">{ fmt.Sprintf("%d", state.UnusedAudios) }</div>
			</div>
			<div class="flex-grow">
				<h2 class="text-sm uppercase text-muted mb-2">Total Used Audios</h2>
				<div class="text-3xl font-bold text-warning">{ fmt.Sprintf("%d", state.UsedAudios) }</div>
			</div>
		</div>
		<div class="grid grid-cols-2 gap-4">
			for _, conn := range state.Connections {
				<div class="bg-white/5 p-3 rounded">
					<div class="text-xs font-mono text-muted mb-2">{ conn.Phone }</div>
					<div class="flex justify-between">
						<div>
							<span class="text-xs text-muted uppercase">Unused:</span> 
							<span class="text-success font-bold">{ fmt.Sprintf("%d", conn.UnusedAudios) }</span>
						</div>
						<div>
							<span class="text-xs text-muted uppercase">Used:</span> 
							<span class="text-warning font-bold">{ fmt.Sprintf("%d", conn.UsedAudios) }</span>
						</div>
					</div>
				</div>
			}
		</div>
	</div>
}

templ QRComponent(conns []WAConnectionState) {
	if len(conns) == 0 {
		<div class="glass qr-card">
			<h2 class="text-sm uppercase text-muted mb-4">WhatsApp Pairing</h2>
			<div class="text-muted text-center">No sender phones configured yet.</div>
		</div>
	}
	for _, conn := range conns {
		<div class="glass qr-card mb-4">
			<div class="flex justify-between items-center mb-4">
				<h2 class="text-sm uppercase text-muted m-0">WhatsApp Pairing ({ conn.Phone })</h2>
				<button 
					type="button" 
					class="btn btn-secondary btn-sm text-xs py-1 px-2.5" 
					style="color: #ef4444; border-color: rgba(239, 68, 68, 0.3);"
					hx-post="/api/sender/disconnect" 
					hx-vals={ fmt.Sprintf(`{"phone": %q}`, conn.Phone) }
					hx-confirm={ fmt.Sprintf("Are you sure you want to disconnect and remove %s?", conn.Phone) }
					hx-target="#qr-card"
					hx-swap="innerHTML"
				>
					Disconnect
				</button>
			</div>
			<div class="text-xs mb-4">
				if conn.Status == StatusConnected {
					<span class="text-success">Connected</span>
				} else if conn.Status == StatusPairingRequired {
					<span class="text-warning">Pairing required</span>
				} else if conn.Status == StatusError {
					<span class="text-danger">Connection error</span>
				} else {
					<span class="text-muted">{ string(conn.Status) }</span>
				}
			</div>
			<div class="qr-container">
				if conn.QRCodeData == "" {
					<div class="text-muted text-center">
						<svg class="svg-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
						if conn.Status == StatusConnected {
							<p>Session active.<br/>No QR code needed.</p>
						} else if conn.Status == StatusError {
							<p>Connection failed.<br/>Waiting for a retry.</p>
						} else {
							<p>Waiting for the client state to settle.</p>
						}
					</div>
				} else {
					<img src={ conn.QRCodeData } class="qr-image" alt="WhatsApp QR Code"/>
					<div class="progress-bar">
						<div class="progress-fill" style="width: 100%;"></div>
					</div>
					<p class="qr-text">Scan promptly. The QR refreshes automatically when WhatsApp rotates it.</p>
				}
			</div>
		</div>
	}
}

templ LogsPage() {
	@Layout("Live Logs - ProFM Jaguare") {
		<div class="container h-screen flex flex-col" hx-ext="sse" sse-connect="/events/logs">
			<header class="header mb-4">
				<div>
					<h1 class="title">🐆 Live Logs</h1>
					<p class="text-muted text-sm">Streaming system output...</p>
				</div>
				<a href="/" class="btn btn-secondary btn-sm">Back to Dashboard</a>
			</header>

			<!-- We use an auto-scrolling container for logs -->
			<div class="logs-container">
				<pre id="log-container" class="logs-pre" sse-swap="log" hx-swap="beforeend"></pre>
			</div>

			<script>
				const container = document.getElementById('log-container');
				// Simple observer to auto-scroll when new content arrives
				const observer = new MutationObserver(() => {
					container.scrollTop = container.scrollHeight;
				});
				observer.observe(container, { childList: true });
			</script>
		</div>
	}
}

templ DataViewer(files []FileInfo) {
	@Layout("Data Viewer - ProFM Jaguare") {
		<div class="container">
			<header class="header flex justify-between items-center mb-6">
				<h1 class="title m-0">📂 Data Viewer</h1>
				<a href="/" class="btn btn-secondary btn-sm">Back to Dashboard</a>
			</header>

			<div class="glass p-6 overflow-x-auto">
				<table class="w-full text-left border-collapse">
					<thead>
						<tr class="border-b border-white/10 text-sm tracking-widest text-white/50 uppercase">
							<th class="p-3">File</th>
							<th class="p-3">Size</th>
							<th class="p-3">Modified</th>
							<th class="p-3">Preview</th>
						</tr>
					</thead>
					<tbody>
						for _, f := range files {
							if !f.IsDir {
								<tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
									<td class="p-3 font-mono text-sm break-all">
										<a href={ templ.URL("/raw-data/" + f.Path) } target="_blank" class="text-primary hover:underline">
											{ f.Path }
										</a>
									</td>
									<td class="p-3 text-sm text-white/70">
										{ fmt.Sprintf("%d bytes", f.Size) }
									</td>
									<td class="p-3 text-sm text-white/70 whitespace-nowrap">
										{ f.ModTime }
									</td>
									<td class="p-3">
										if strings.HasSuffix(f.Name, ".ogg") || strings.HasSuffix(f.Name, ".mp3") || strings.HasSuffix(f.Name, ".wav") {
											<audio controls preload="none" style="height: 32px; width: 250px;">
												<source src={ "/raw-data/" + f.Path } type={ audioMimeType(f.Name) } />
												Your browser does not support the audio element.
											</audio>
										}
									</td>
								</tr>
							}
						}
						if len(files) == 0 {
							<tr>
								<td colspan="4" class="p-6 text-center text-white/50">No files found.</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

templ RadioLogsPage(logs []RadioLog) {
	@Layout("Radio Log History - ProFM Jaguare") {
		<div class="container">
			<header class="header flex justify-between items-center mb-6">
				<h1 class="title m-0">📻 Radio Log History</h1>
				<a href="/" class="btn btn-secondary btn-sm">Back to Dashboard</a>
			</header>

			<div class="glass p-6 overflow-x-auto">
				<table class="w-full text-left border-collapse">
					<thead>
						<tr class="border-b border-white/10 text-sm tracking-widest text-white/50 uppercase">
							<th class="p-3">ID</th>
							<th class="p-3">Time Played</th>
							<th class="p-3">Artist</th>
							<th class="p-3">Title</th>
						</tr>
					</thead>
					<tbody>
						for _, l := range logs {
							<tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
								<td class="p-3 font-mono text-sm">{ fmt.Sprintf("%d", l.ID) }</td>
								<td class="p-3 text-sm text-white/70">{ l.PlayedDatetime }</td>
								<td class="p-3 font-semibold">{ l.Artist }</td>
								<td class="p-3">{ l.Title }</td>
							</tr>
						}
						if len(logs) == 0 {
							<tr>
								<td colspan="4" class="p-6 text-center text-white/50">No radio logs recorded yet.</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

templ AlertsPage(alerts []AlertRecord) {
	@Layout("System Alerts - ProFM Jaguare") {
		<div class="container">
			<header class="header flex justify-between items-center mb-6">
				<h1 class="title m-0">🔔 System Alerts</h1>
				<a href="/" class="btn btn-secondary btn-sm">Back to Dashboard</a>
			</header>

			<div class="card p-6">
				if len(alerts) == 0 {
					<p class="text-muted text-center py-4">No alerts found in the database.</p>
				} else {
					<div class="table-container mt-4" style="max-height: 80vh; overflow-y: auto;">
						<table class="table" style="width: 100%; border-collapse: collapse;">
							<thead>
								<tr style="border-bottom: 1px solid var(--border-color);">
									<th style="padding: 12px; text-align: left;">Time</th>
									<th style="padding: 12px; text-align: left;">Level</th>
									<th style="padding: 12px; text-align: left;">Title</th>
									<th style="padding: 12px; text-align: left;">Message</th>
								</tr>
							</thead>
							<tbody>
								for _, a := range alerts {
									<tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
										<td class="text-muted text-sm" style="padding: 12px; white-space: nowrap;">{ a.CreatedAt }</td>
										<td style="padding: 12px;">
											if a.Level == "CRITICAL" {
												<span class="badge bg-danger">CRITICAL</span>
											} else if a.Level == "SUCCESS" {
												<span class="badge" style="background-color: var(--success-color); color: #000;">SUCCESS</span>
											} else {
												<span class="badge bg-info">INFO</span>
											}
										</td>
										<td style="padding: 12px; font-weight: 500;">{ a.Title }</td>
										<td style="padding: 12px; opacity: 0.8; font-size: 0.9em; max-width: 400px; word-wrap: break-word;">{ a.Message }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}
