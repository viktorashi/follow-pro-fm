package poller

import (
	"fmt"
	"strings"
	"time"
)

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title }</title>
		<!-- HTMX -->
		<script src="/static/htmx.min.js"></script>
		<script src="/static/sse.js"></script>
		<script src="https://unpkg.com/wavesurfer.js@7/dist/wavesurfer.min.js"></script>
		<script src="https://unpkg.com/wavesurfer.js@7/dist/plugins/regions.min.js"></script>
		<link rel="stylesheet" href="/static/style.css"/>
	</head>
	<body class="flex flex-col">
		<div class="flex-grow flex flex-col">
			{ children... }
		</div>
	</body>
	</html>
}

templ Login() {
	@Layout("Login - ProFM Jaguare") {
		<div class="flex flex-col items-center justify-center flex-grow p-4">
			<div class="glass p-8 max-w-md w-full">
				<h1 class="title-large">Jaguare Login</h1>
				
				<form action="/login" method="POST" class="space-y-4">
					<div>
						<label class="text-sm font-medium mb-1">Trusted Email</label>
						<input type="email" name="email" required class="input"/>
					</div>
					<div>
						<label class="text-sm font-medium mb-1">Password</label>
						<input type="password" name="password" required class="input"/>
					</div>
					<button type="submit" class="btn btn-primary">Login</button>
				</form>

				<div class="mt-6 border-t pt-6">
					<form hx-post="/auth/magic/request" hx-target="#magic-result" class="space-y-4">
						<p class="text-sm text-muted text-center mb-2">Or use Magic Link</p>
						<div>
							<input type="email" name="email" placeholder="Enter Trusted Email" required class="input"/>
						</div>
						<button type="submit" class="btn btn-success">NU MAI STIU PAROLA AAA</button>
						<div id="magic-result" class="text-sm text-success text-center mt-2"></div>
					</form>
				</div>
			</div>
		</div>
	}
}

templ Dashboard(state AppState, chunks []ReviewChunk, canonicalChunks []ReviewChunk, phones []string, schedules []ScheduleEntry, campaignArtists []string) {
	@Layout("Dashboard - ProFM Jaguare") {
		<script>
			function toggleGathering() {
				fetch('/api/settings/gathering', {method: 'POST'})
					.then(() => window.location.reload());
			}
			function cropUnreviewed(event, form) {
				event.preventDefault();
				const data = new FormData(form);
				fetch('/unreviewed/crop', {
					method: 'POST',
					body: data
				}).then(async res => {
					if (!res.ok) {
						const payload = await res.json().catch(() => ({}));
						throw new Error(payload.error || 'Crop failed');
					}
					window.location.reload();
				}).catch(err => {
					alert(err.message);
				});
				return false;
			}
			function remuxAllUnreviewed() {
				fetch('/api/unreviewed/remux-all', { method: 'POST' })
					.then(async res => {
						const data = await res.json().catch(() => ({}));
						if (!res.ok) throw new Error(data.error || 'Remux failed');
						alert(`Successfully remuxed ${data.count} chunks!`);
						window.location.reload();
					})
					.catch(err => alert(err.message));
			}
			function addCampaignPhrase(event, form) {
				event.preventDefault();
				const data = new FormData(form);
				fetch('/api/campaigns/phrases', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						campaign_artist: data.get('campaign_artist'),
						phrase: data.get('phrase')
					})
				}).then(async res => {
					if (!res.ok) {
						const payload = await res.json().catch(() => ({}));
						throw new Error(payload.error || 'Add phrase failed');
					}
					window.location.reload();
				}).catch(err => alert(err.message));
				return false;
			}
			function transcribeChunk(name, bucket) {
				const btn = event.target;
				const origText = btn.textContent;
				btn.textContent = 'Transcribing...';
				btn.disabled = true;
				
				fetch('/api/signatures/transcribe', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ filename: name, bucket: bucket })
				}).then(async res => {
					if (!res.ok) {
						const payload = await res.json().catch(() => ({}));
						throw new Error(payload.error || 'Transcription failed');
					}
					window.location.reload();
				}).catch(err => {
					alert(err.message);
					btn.textContent = origText;
					btn.disabled = false;
				});
			}

			window.waveSurfers = window.waveSurfers || {};
			window.initWaveformEditor = function(chunkName, url, duration) {
				document.getElementById('loader-btn-' + chunkName).style.display = 'none';
				document.getElementById('editor-container-' + chunkName).classList.remove('hidden');
				
				const ws = WaveSurfer.create({
					container: document.getElementById('waveform-' + chunkName),
					waveColor: 'rgba(255, 255, 255, 0.4)',
					progressColor: '#3b82f6',
					url: url,
					height: 96
				});
				
				const wsRegions = ws.registerPlugin(WaveSurfer.Regions.create());
				
				ws.on('ready', () => {
					const region = wsRegions.addRegion({
						start: 0,
						end: duration,
						color: 'rgba(59, 130, 246, 0.3)',
						resize: true,
						drag: true
					});
					
					region.on('update', () => {
						document.getElementById('start-input-' + chunkName).value = region.start;
						document.getElementById('start-val-' + chunkName).textContent = region.start.toFixed(2);
						document.getElementById('end-input-' + chunkName).value = region.end;
						document.getElementById('end-val-' + chunkName).textContent = region.end.toFixed(2);
					});
				});
				
				window.waveSurfers[chunkName] = ws;
			};

			window.playPauseWaveform = function(chunkName) {
				const ws = window.waveSurfers[chunkName];
				if (ws) ws.playPause();
			};

			function showTab(tabName) {
				document.querySelectorAll('.matcher-tab-btn').forEach(btn => {
					if (btn.dataset.target === tabName) {
						btn.classList.add('text-primary');
						btn.classList.remove('text-muted');
					} else {
						btn.classList.add('text-muted');
						btn.classList.remove('text-primary');
					}
				});
				document.querySelectorAll('.matcher-tab-content').forEach(content => {
					content.style.display = content.id === 'tab-' + tabName ? 'block' : 'none';
				});
			}
			function uploadAudio(event, form) {
				event.preventDefault();
				const data = new FormData(form);
				const result = document.getElementById('upload-audio-result');
				result.textContent = 'Uploading...';
				result.className = 'mt-4 text-sm text-muted';
				fetch('/api/audio/upload', {
					method: 'POST',
					body: data
				}).then(async res => {
					const text = await res.text();
					result.textContent = text;
					result.className = res.ok ? 'mt-4 text-sm text-success' : 'mt-4 text-sm text-warning';
					if (!res.ok) {
						throw new Error(text || 'Upload failed');
					}
					form.reset();
				}).catch(() => {});
				return false;
			}
			function saveSchedule(event, form) {
				event.preventDefault();
				const raw = form.target_matches.value.trim();
				const result = document.getElementById('schedule-result');
				const values = raw === '' ? [] : raw.split(',').map(part => part.trim()).filter(Boolean);
				const matches = [];
				for (const value of values) {
					const parsed = Number.parseInt(value, 10);
					if (!Number.isInteger(parsed)) {
						result.textContent = 'Target matches must be a comma-separated list of integers.';
						result.className = 'mt-4 text-sm text-warning';
						return false;
					}
					matches.push(parsed);
				}

				result.textContent = 'Saving...';
				result.className = 'mt-4 text-sm text-muted';
				fetch('/api/schedule', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						date: form.date.value,
						target_matches: matches
					})
				}).then(async res => {
					const payload = await res.json().catch(() => ({}));
					if (!res.ok) {
						throw new Error(payload.error || 'Save failed');
					}
					result.textContent = 'Schedule saved.';
					result.className = 'mt-4 text-sm text-success';
					window.location.reload();
				}).catch(err => {
					result.textContent = err.message;
					result.className = 'mt-4 text-sm text-warning';
				});
				return false;
			}
			function fillAllSchedules() {
				const result = document.getElementById('schedule-result');
				result.textContent = 'Filling all campaign days with 1,2,3,4,5,6...';
				result.className = 'mt-4 text-sm text-muted';
				fetch('/api/schedule', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						date: '*',
						target_matches: [1, 2, 3, 4, 5, 6]
					})
				}).then(async res => {
					const payload = await res.json().catch(() => ({}));
					if (!res.ok) {
						throw new Error(payload.error || 'Fill failed');
					}
					result.textContent = `Updated ${payload.updated_days} campaign days to 1, 2, 3, 4, 5, 6.`;
					result.className = 'mt-4 text-sm text-success';
					window.location.reload();
				}).catch(err => {
					result.textContent = err.message;
					result.className = 'mt-4 text-sm text-warning';
				});
			}
			function toggleKillSwitch(active) {
				const pw = prompt(active ? "⚠️ DANGER! Enter Admin Password to permanently disable the bot:" : "Enter Admin Password to re-enable the bot:");
				if (!pw) return;
				fetch('/api/kill-switch', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ password: pw, active: active })
				}).then(res => {
					if (!res.ok) alert("Invalid password or server error");
				});
			}

			document.addEventListener("DOMContentLoaded", function() {
				// Initialize the ticking clock using the server's time
				const timeEl = document.getElementById('server-time');
				let currentServerMs = parseInt(timeEl.getAttribute('data-server-time'), 10);
				setInterval(() => {
					currentServerMs += 1000;
					const d = new Date(currentServerMs);
					timeEl.innerText = d.toLocaleTimeString('ro-RO');
				}, 1000);
			});
		</script>
		<div class="container" hx-ext="sse" sse-connect="/events/dashboard">
			<header class="header flex justify-between items-center">
				<h1 class="title m-0">🐆 Telemetrie pe ProFM, Jaguare</h1>
				<div class="flex items-center gap-4">
					<div class="text-sm font-mono bg-black/20 px-3 py-1 rounded border border-white/10" id="server-time" data-server-time={ fmt.Sprintf("%d", time.Now().UnixMilli()) }>
						{ time.Now().Format("15:04:05") }
					</div>
					<div class="flex gap-2">
						<button onclick="toggleGathering()" class="btn btn-secondary btn-sm">Toggle Gathering</button>
						<button onclick="toggleKillSwitch(true)" class="btn btn-danger btn-sm">🏆 I WON (KILL BOT)</button>
						<button onclick="toggleKillSwitch(false)" class="btn btn-secondary btn-sm">UNDO KILL</button>
						<a href="/data" class="btn btn-secondary btn-sm">Files</a>
						<a href="/radio-logs" class="btn btn-secondary btn-sm">Radio History</a>
						<a href="/logs" class="btn btn-secondary btn-sm">Logs</a>
						<a href="/logout" class="btn btn-secondary btn-sm">Logout</a>
					</div>
				</div>
			</header>

			<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
				<!-- Left Column: Status & Stats -->
				<div class="space-y-6 col-span-2">
					<!-- State Machine Status -->
					<div class="glass" id="status-card" sse-swap="status">
						@StatusComponent(state)
					</div>

					<!-- Current Song -->
					<div class="glass" id="song-card" sse-swap="song">
						@SongComponent(state.CurrentSong)
					</div>

					<!-- Audio Stats -->
					<div class="glass flex justify-between" id="audio-card" sse-swap="audio">
						@AudioStatsComponent(state)
					</div>

					<div class="glass p-6" id="matcher-data">
						<div class="flex justify-between items-center mb-4">
							<div>
								<h2 class="text-sm uppercase text-muted mb-1">Matcher-related data</h2>
								if state.GatheringSignatures {
									<div class="text-sm text-success">Gathering enabled</div>
								} else {
									<div class="text-sm text-warning">Gathering disabled</div>
								}
							</div>
							<div class="flex gap-2">
								<button onclick="remuxAllUnreviewed()" class="btn btn-primary btn-sm">Fix Infinite Audios</button>
								<a href="/api/unreviewed" class="btn btn-secondary btn-sm" target="_blank">List JSON</a>
							</div>
						</div>

						<div class="flex gap-2 border-b border-white/10 mb-6 pb-0">
							<button class="matcher-tab-btn font-semibold text-primary" data-target="fingerprint" onclick="showTab('fingerprint')">Unreviewed Signatures</button>
							<button class="matcher-tab-btn font-semibold text-muted" data-target="canonical" onclick="showTab('canonical')">Canonical Signatures</button>
							<button class="matcher-tab-btn font-semibold text-muted" data-target="transcription" onclick="showTab('transcription')">Transcription Phrases</button>
						</div>

						<div id="tab-fingerprint" class="matcher-tab-content">
							if len(chunks) == 0 {
								<div class="text-sm text-muted">No unreviewed chunks waiting for manual review.</div>
							} else {
								<div class="space-y-4">
									for _, chunk := range chunks {
										<div class="border border-white/10 rounded p-4">
											<div class="flex justify-between items-center gap-4 mb-3">
												<div>
													<div class="font-semibold break-all">{ chunk.Name }</div>
													<div class="text-xs text-muted">{ fmt.Sprintf("%.2f MB", float64(chunk.Size)/(1024*1024)) } ({ fmt.Sprintf("%.0fs", chunk.DurationSeconds) }) · { chunk.ModTime }</div>
												</div>
												<a href={ templ.URL(chunk.PlayURL) } target="_blank" class="btn btn-secondary btn-sm">Open</a>
											</div>
											<div id={ "editor-container-" + chunk.Name } class="w-full bg-black/30 rounded p-2 mb-3 hidden">
												<div id={ "waveform-" + chunk.Name } class="w-full h-24 mb-2"></div>
												
												<form onsubmit="return cropUnreviewed(event, this)" class="flex flex-col gap-2">
													<input type="hidden" name="filename" value={ chunk.Name }/>
													<input type="hidden" name="start_seconds" id={ "start-input-" + chunk.Name } value="0"/>
													<input type="hidden" name="end_seconds" id={ "end-input-" + chunk.Name } value={ fmt.Sprintf("%.1f", chunk.DurationSeconds) }/>
													
													<div class="flex justify-between items-center text-xs text-muted mb-2">
														<div>Start: <span id={ "start-val-" + chunk.Name }>0.00</span>s</div>
														<div>End: <span id={ "end-val-" + chunk.Name }>{ fmt.Sprintf("%.2f", chunk.DurationSeconds) }</span>s</div>
													</div>
													
													<div class="flex justify-between mt-2">
														<button type="button" class="btn btn-secondary btn-sm"
															data-name={ chunk.Name }
															onclick="window.playPauseWaveform(this.dataset.name)">Play / Pause</button>
														<button type="submit" class="btn btn-primary btn-sm">Crop to Canonical</button>
													</div>
												</form>
											</div>
											
											<div id={ "loader-btn-" + chunk.Name } class="flex justify-center mb-3">
												<button type="button" class="btn btn-secondary btn-sm w-full py-4 bg-black/20"
													data-name={ chunk.Name }
													data-url={ chunk.PlayURL }
													data-duration={ fmt.Sprintf("%f", chunk.DurationSeconds) }
													onclick="window.initWaveformEditor(this.dataset.name, this.dataset.url, parseFloat(this.dataset.duration))">
													🎙️ Load Audio Editor
												</button>
											</div>

											if chunk.Transcript != "" {
												<div class="bg-black/20 p-3 rounded font-mono text-sm border-l-2 border-primary">
													<div class="text-xs text-muted mb-1 uppercase tracking-wider">Transcription:</div>
													"{ chunk.Transcript }"
												</div>
											} else {
												<div class="flex items-center justify-between gap-4 bg-black/10 p-3 rounded">
													<div class="text-xs text-muted italic">No transcription available.</div>
													<button type="button" class="btn btn-secondary btn-sm"
														data-name={ chunk.Name }
														data-bucket="unreviewed"
														onclick="window.transcribeChunk(this.dataset.name, this.dataset.bucket)">Transcribe</button>
												</div>
											}
										</div>
									}
								</div>
							}
						</div>

						<div id="tab-transcription" class="matcher-tab-content" style="display: none;">
							<div class="border border-white/10 rounded p-4 mb-6 bg-black/20">
								<div class="font-semibold text-sm mb-2 text-primary">Add Manual Phrase</div>
								<form onsubmit="return addCampaignPhrase(event, this)" class="flex gap-2 items-end">
									<div class="flex-grow flex gap-2">
										<select name="campaign_artist" class="input flex-grow" required>
											<option value="" disabled selected>Select Campaign Artist...</option>
											for _, artist := range campaignArtists {
												<option value={ artist }>{ artist }</option>
											}
										</select>
										<input type="text" name="phrase" placeholder="Phrase text..." class="input flex-grow" required />
									</div>
									<button type="submit" class="btn btn-primary btn-sm whitespace-nowrap">Add Phrase</button>
								</form>
							</div>

							if len(chunks) == 0 {
								<div class="text-sm text-muted">No transcriptions waiting for manual review.</div>
							} else {
								<div class="space-y-4">
									for _, chunk := range chunks {
										if chunk.Transcript != "" {
											<div class="border border-white/10 rounded p-4 mb-3">
												<div class="font-semibold text-sm mb-2">Audio: { chunk.Name }</div>
												<div class="bg-black/20 p-3 rounded font-mono text-sm mb-3">"{ chunk.Transcript }"</div>
												<form onsubmit="return addCampaignPhrase(event, this)" class="flex gap-2 items-end">
													<select name="campaign_artist" class="input flex-grow" required>
														if chunk.CampaignArtist == "" {
															<option value="" disabled selected>Select Campaign Artist...</option>
														}
														for _, artist := range campaignArtists {
															<option value={ artist } selected?={ strings.EqualFold(artist, chunk.CampaignArtist) }>{ artist }</option>
														}
													</select>
													<input type="text" name="phrase" value={ chunk.Transcript } class="input flex-grow" required />
													<button type="submit" class="btn btn-primary btn-sm">Add Phrase</button>
												</form>
											</div>
										}
									}
								</div>
							}
						</div>

						<div id="tab-canonical" class="matcher-tab-content" style="display: none;">
							if len(canonicalChunks) == 0 {
								<div class="text-sm text-muted">No canonical signatures exist yet.</div>
							} else {
								<div class="space-y-4">
									for _, chunk := range canonicalChunks {
										<div class="border border-white/10 rounded p-4 mb-3">
											<div class="flex justify-between items-center gap-4 mb-3">
												<div>
													<div class="font-semibold break-all">{ chunk.Name }</div>
													<div class="text-xs text-muted">{ fmt.Sprintf("%.2f MB", float64(chunk.Size)/(1024*1024)) } ({ fmt.Sprintf("%.0fs", chunk.DurationSeconds) }) · { chunk.ModTime }</div>
												</div>
												<div class="flex gap-2">
													<a href={ templ.URL(chunk.PlayURL) } target="_blank" class="btn btn-secondary btn-sm">Listen</a>
												</div>
											</div>
											if chunk.Transcript != "" {
												<div class="bg-black/20 p-3 rounded font-mono text-sm border-l-2 border-primary">
													<div class="text-xs text-muted mb-1 uppercase tracking-wider">Transcription:</div>
													"{ chunk.Transcript }"
												</div>
											} else {
												<div class="flex items-center justify-between gap-4 bg-black/10 p-3 rounded">
													<div class="text-xs text-muted italic">No transcription available.</div>
													<button type="button" class="btn btn-secondary btn-sm"
														data-name={ chunk.Name }
														data-bucket="canonical"
														onclick="window.transcribeChunk(this.dataset.name, this.dataset.bucket)">Transcribe</button>
												</div>
											}
										</div>
									}
								</div>
							}
						</div>
					</div>
				</div>

				<!-- Right Column: QR Code & Logs -->
				<div class="space-y-6">
					<div id="qr-card" sse-swap="qrcode">
						@QRComponent(state.Connections)
					</div>

					<div class="glass p-6">
						<h2 class="text-sm uppercase text-muted mb-4">Add Sender Phone</h2>
						<form hx-post="/api/sender/add" hx-target="#add-sender-result" hx-swap="innerHTML">
							<button type="submit" class="btn btn-secondary">Add phone and show QR code</button>
						</form>
						<div id="add-sender-result" class="mt-4 text-sm text-warning"></div>
					</div>

					<div class="glass p-6">
						<h2 class="text-sm uppercase text-muted mb-4">Upload Voice Note</h2>
						<form onsubmit="return uploadAudio(event, this)" enctype="multipart/form-data" class="space-y-4">
							<div>
								<label class="text-xs text-muted mb-1">Phone pool</label>
								<select name="phone" class="input" required>
									for _, phone := range phones {
										<option value={ phone }>
											{ phone }
											if phone == CanonicalSenderPhone {
												{ " (canonical)" }
											}
										</option>
									}
								</select>
							</div>
							<div>
								<label class="text-xs text-muted mb-1">.ogg voice note (files or folders)</label>
								<input type="file" name="audio" accept=".ogg,audio/ogg" class="input w-full" multiple webkitdirectory directory title="Select files or folders" />
							</div>
							<button type="submit" class="btn btn-primary">Upload</button>
						</form>
						<div id="upload-audio-result" class="mt-4 text-sm text-muted">Uploads land in the active pool, never in <code>used/</code>.</div>
					</div>

					<div class="glass p-6">
						<div class="flex justify-between items-center mb-4">
							<div>
								<h2 class="text-sm uppercase text-muted mb-1">Daily RNG Schedule</h2>
								<div class="text-xs text-muted">Edit the stored daily match indices used by the RNG gate.</div>
							</div>
							<a href="/api/schedule" class="btn btn-secondary btn-sm" target="_blank">JSON</a>
						</div>
						<form onsubmit="return saveSchedule(event, this)" class="space-y-4">
							<div>
								<label class="text-xs text-muted mb-1">Date</label>
								<input type="date" name="date" class="input" required />
							</div>
							<div>
								<label class="text-xs text-muted mb-1">Target matches</label>
								<input type="text" name="target_matches" placeholder="1,3,5" class="input" required />
							</div>
							<div class="flex gap-2">
								<button type="submit" class="btn btn-primary">Save Schedule</button>
								<button type="button" class="btn btn-secondary" onclick="fillAllSchedules()">All 6/6</button>
							</div>
						</form>
						<div id="schedule-result" class="mt-4 text-sm text-muted">Use comma-separated match indices such as <code>1, 3, 5</code>.</div>
						if len(schedules) == 0 {
							<div class="mt-4 text-sm text-muted">No schedules stored yet.</div>
						} else {
							<div class="mt-4 space-y-2 max-h-72 overflow-y-auto">
								for _, schedule := range schedules {
									<div class="border border-white/10 rounded p-3">
										<div class="text-sm font-semibold">{ schedule.Date }</div>
										<div class="text-xs text-muted">Target matches: { formatScheduleTargets(schedule.TargetMatches) }</div>
									</div>
								}
							</div>
						}
					</div>
				</div>
			</div>
		</div>
	}
}

templ StatusComponent(state AppState) {
	<h2 class="text-sm uppercase text-muted mb-2">System Status</h2>
	<div class="flex items-center space-x-3">
		if state.Status == StatusConnected || state.Status == StatusPolling {
			<span class="status-indicator status-success">
			  <span class="status-ping"></span>
			  <span class="status-dot"></span>
			</span>
			<span class="text-2xl font-semibold text-success">{ string(state.Status) }</span>
		} else if state.Status == StatusPairingRequired {
			<span class="status-indicator status-warning">
			  <span class="status-ping"></span>
			  <span class="status-dot"></span>
			</span>
			<span class="text-2xl font-semibold text-warning">{ string(state.Status) }</span>
		} else if state.Status == StatusKilled {
			<span class="text-3xl font-black text-warning tracking-widest text-center block w-full py-6">
			  🎉 WINNER! BOT IS PERMANENTLY DISABLED
			</span>
		} else if state.Status == StatusError || state.Status == StatusAudioExhausted {
			<span class="status-indicator status-danger">
			  <span class="status-ping"></span>
			  <span class="status-dot"></span>
			</span>
			<span class="text-2xl font-semibold text-danger">{ string(state.Status) }</span>
		} else if state.Status == StatusSleeping {
			<span class="status-indicator status-neutral">
			  <span class="status-dot"></span>
			</span>
			<span class="text-2xl font-semibold text-muted">{ string(state.Status) }</span>
		} else {
			<span class="status-indicator status-neutral">
			  <span class="status-dot"></span>
			</span>
			<span class="text-2xl font-semibold text-muted">{ string(state.Status) }</span>
		}
	</div>
	if state.LastError != "" {
		<div class="error-box">
			{ state.LastError }
		</div>
	}
}

templ SongComponent(song string) {
	<h2 class="text-sm uppercase text-muted mb-2">Acum joaca:</h2>
	if song == "" {
		<div class="text-xl text-muted italic">Waiting for broadcast...</div>
	} else {
		<div class="text-2xl font-bold">{ song }</div>
	}
}

templ AudioStatsComponent(state AppState) {
	<div class="w-full">
		<div class="flex justify-between mb-4 border-b border-white/10 pb-4">
			<div class="flex-grow">
				<h2 class="text-sm uppercase text-muted mb-2">Total Unused Audios</h2>
				<div class="text-3xl font-bold text-success">{ fmt.Sprintf("%d", state.UnusedAudios) }</div>
			</div>
			<div class="flex-grow">
				<h2 class="text-sm uppercase text-muted mb-2">Total Used Audios</h2>
				<div class="text-3xl font-bold text-warning">{ fmt.Sprintf("%d", state.UsedAudios) }</div>
			</div>
		</div>
		<div class="grid grid-cols-2 gap-4">
			for _, conn := range state.Connections {
				<div class="bg-white/5 p-3 rounded">
					<div class="text-xs font-mono text-muted mb-2">{ conn.Phone }</div>
					<div class="flex justify-between">
						<div>
							<span class="text-xs text-muted uppercase">Unused:</span> 
							<span class="text-success font-bold">{ fmt.Sprintf("%d", conn.UnusedAudios) }</span>
						</div>
						<div>
							<span class="text-xs text-muted uppercase">Used:</span> 
							<span class="text-warning font-bold">{ fmt.Sprintf("%d", conn.UsedAudios) }</span>
						</div>
					</div>
				</div>
			}
		</div>
	</div>
}

templ QRComponent(conns []WAConnectionState) {
	if len(conns) == 0 {
		<div class="glass qr-card">
			<h2 class="text-sm uppercase text-muted mb-4">WhatsApp Pairing</h2>
			<div class="text-muted text-center">No sender phones configured yet.</div>
		</div>
	}
	for _, conn := range conns {
		<div class="glass qr-card mb-4">
			<h2 class="text-sm uppercase text-muted mb-4">WhatsApp Pairing ({ conn.Phone })</h2>
			<div class="text-xs mb-4">
				if conn.Status == StatusConnected {
					<span class="text-success">Connected</span>
				} else if conn.Status == StatusPairingRequired {
					<span class="text-warning">Pairing required</span>
				} else if conn.Status == StatusError {
					<span class="text-danger">Connection error</span>
				} else {
					<span class="text-muted">{ string(conn.Status) }</span>
				}
			</div>
			<div class="qr-container">
				if conn.QRCodeData == "" {
					<div class="text-muted text-center">
						<svg class="svg-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
						if conn.Status == StatusConnected {
							<p>Session active.<br/>No QR code needed.</p>
						} else if conn.Status == StatusError {
							<p>Connection failed.<br/>Waiting for a retry.</p>
						} else {
							<p>Waiting for the client state to settle.</p>
						}
					</div>
				} else {
					<img src={ conn.QRCodeData } class="qr-image" alt="WhatsApp QR Code"/>
					<div class="progress-bar">
						<div class="progress-fill" style="width: 100%;"></div>
					</div>
					<p class="qr-text">Scan promptly. The QR refreshes automatically when WhatsApp rotates it.</p>
				}
			</div>
		</div>
	}
}

templ LogsPage() {
	@Layout("Live Logs - ProFM Jaguare") {
		<div class="container h-screen flex flex-col" hx-ext="sse" sse-connect="/events/logs">
			<header class="header mb-4">
				<div>
					<h1 class="title">🐆 Live Logs</h1>
					<p class="text-muted text-sm">Streaming system output...</p>
				</div>
				<a href="/" class="btn btn-secondary btn-sm">Back to Dashboard</a>
			</header>

			<!-- We use an auto-scrolling container for logs -->
			<div class="logs-container">
				<pre id="log-container" class="logs-pre" sse-swap="log" hx-swap="beforeend"></pre>
			</div>

			<script>
				const container = document.getElementById('log-container');
				// Simple observer to auto-scroll when new content arrives
				const observer = new MutationObserver(() => {
					container.scrollTop = container.scrollHeight;
				});
				observer.observe(container, { childList: true });
			</script>
		</div>
	}
}

templ DataViewer(files []FileInfo) {
	@Layout("Data Viewer - ProFM Jaguare") {
		<div class="container">
			<header class="header flex justify-between items-center mb-6">
				<h1 class="title m-0">📂 Data Viewer</h1>
				<a href="/" class="btn btn-secondary btn-sm">Back to Dashboard</a>
			</header>

			<div class="glass p-6 overflow-x-auto">
				<table class="w-full text-left border-collapse">
					<thead>
						<tr class="border-b border-white/10 text-sm tracking-widest text-white/50 uppercase">
							<th class="p-3">File</th>
							<th class="p-3">Size</th>
							<th class="p-3">Modified</th>
							<th class="p-3">Preview</th>
						</tr>
					</thead>
					<tbody>
						for _, f := range files {
							if !f.IsDir {
								<tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
									<td class="p-3 font-mono text-sm break-all">
										<a href={ templ.URL("/raw-data/" + f.Path) } target="_blank" class="text-primary hover:underline">
											{ f.Path }
										</a>
									</td>
									<td class="p-3 text-sm text-white/70">
										{ fmt.Sprintf("%d bytes", f.Size) }
									</td>
									<td class="p-3 text-sm text-white/70 whitespace-nowrap">
										{ f.ModTime }
									</td>
									<td class="p-3">
										if strings.HasSuffix(f.Name, ".ogg") || strings.HasSuffix(f.Name, ".mp3") || strings.HasSuffix(f.Name, ".wav") {
											<audio controls preload="none" style="height: 32px; width: 250px;">
												<source src={ "/raw-data/" + f.Path } type={ audioMimeType(f.Name) } />
												Your browser does not support the audio element.
											</audio>
										}
									</td>
								</tr>
							}
						}
						if len(files) == 0 {
							<tr>
								<td colspan="4" class="p-6 text-center text-white/50">No files found.</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

templ RadioLogsPage(logs []RadioLog) {
	@Layout("Radio Log History - ProFM Jaguare") {
		<div class="container">
			<header class="header flex justify-between items-center mb-6">
				<h1 class="title m-0">📻 Radio Log History</h1>
				<a href="/" class="btn btn-secondary btn-sm">Back to Dashboard</a>
			</header>

			<div class="glass p-6 overflow-x-auto">
				<table class="w-full text-left border-collapse">
					<thead>
						<tr class="border-b border-white/10 text-sm tracking-widest text-white/50 uppercase">
							<th class="p-3">ID</th>
							<th class="p-3">Time Played</th>
							<th class="p-3">Artist</th>
							<th class="p-3">Title</th>
						</tr>
					</thead>
					<tbody>
						for _, l := range logs {
							<tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
								<td class="p-3 font-mono text-sm">{ fmt.Sprintf("%d", l.ID) }</td>
								<td class="p-3 text-sm text-white/70">{ l.PlayedDatetime }</td>
								<td class="p-3 font-semibold">{ l.Artist }</td>
								<td class="p-3">{ l.Title }</td>
							</tr>
						}
						if len(logs) == 0 {
							<tr>
								<td colspan="4" class="p-6 text-center text-white/50">No radio logs recorded yet.</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}
