package poller

import (
	"fmt"
	"strings"
	"time"
)

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title }</title>
		<!-- HTMX -->
		<script src="/static/htmx.min.js"></script>
		<script src="/static/sse.js"></script>
		<link rel="stylesheet" href="/static/style.css"/>
	</head>
	<body class="flex flex-col">
		<div class="flex-grow flex flex-col">
			{ children... }
		</div>
	</body>
	</html>
}

templ Login() {
	@Layout("Login - ProFM Jaguare") {
		<div class="flex flex-col items-center justify-center flex-grow p-4">
			<div class="glass p-8 max-w-md w-full">
				<h1 class="title-large">Jaguare Login</h1>
				
				<form action="/login" method="POST" class="space-y-4">
					<div>
						<label class="text-sm font-medium mb-1">Trusted Email</label>
						<input type="email" name="email" required class="input"/>
					</div>
					<div>
						<label class="text-sm font-medium mb-1">Password</label>
						<input type="password" name="password" required class="input"/>
					</div>
					<button type="submit" class="btn btn-primary">Login</button>
				</form>

				<div class="mt-6 border-t pt-6">
					<form hx-post="/auth/magic/request" hx-target="#magic-result" class="space-y-4">
						<p class="text-sm text-muted text-center mb-2">Or use Magic Link</p>
						<div>
							<input type="email" name="email" placeholder="Enter Trusted Email" required class="input"/>
						</div>
						<button type="submit" class="btn btn-success">NU MAI STIU PAROLA AAA</button>
						<div id="magic-result" class="text-sm text-success text-center mt-2"></div>
					</form>
				</div>
			</div>
		</div>
	}
}

templ Dashboard() {
	@Layout("Dashboard - ProFM Jaguare") {
		<script>
			function toggleKillSwitch(active) {
				const pw = prompt(active ? "⚠️ DANGER! Enter Admin Password to permanently disable the bot:" : "Enter Admin Password to re-enable the bot:");
				if (!pw) return;
				fetch('/api/kill-switch', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ password: pw, active: active })
				}).then(res => {
					if (!res.ok) alert("Invalid password or server error");
				});
			}

			document.addEventListener("DOMContentLoaded", function() {
				// Initialize the ticking clock using the server's time
				const timeEl = document.getElementById('server-time');
				let currentServerMs = parseInt(timeEl.getAttribute('data-server-time'), 10);
				setInterval(() => {
					currentServerMs += 1000;
					const d = new Date(currentServerMs);
					timeEl.innerText = d.toLocaleTimeString('ro-RO');
				}, 1000);
			});
		</script>
		<div class="container" hx-ext="sse" sse-connect="/events/dashboard">
			<header class="header flex justify-between items-center">
				<h1 class="title m-0">🐆 ProFM Jaguare Telemetry</h1>
				<div class="flex items-center gap-4">
					<div class="text-sm font-mono bg-black/20 px-3 py-1 rounded border border-white/10" id="server-time" data-server-time={ fmt.Sprintf("%d", time.Now().UnixMilli()) }>
						{ time.Now().Format("15:04:05") }
					</div>
					<div class="flex gap-2">
						<button onclick="toggleKillSwitch(true)" class="btn btn-danger btn-sm">🏆 I WON (KILL BOT)</button>
						<button onclick="toggleKillSwitch(false)" class="btn btn-secondary btn-sm">UNDO KILL</button>
						<a href="/data" class="btn btn-secondary btn-sm">Files</a>
						<a href="/radio-logs" class="btn btn-secondary btn-sm">Radio History</a>
						<a href="/logs" class="btn btn-secondary btn-sm">Logs</a>
						<a href="/logout" class="btn btn-secondary btn-sm">Logout</a>
					</div>
				</div>
			</header>

			<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
				<!-- Left Column: Status & Stats -->
				<div class="space-y-6 col-span-2">
					<!-- State Machine Status -->
					<div class="glass" id="status-card" sse-swap="status">
						@StatusComponent(AppState{Status: StatusInitializing})
					</div>

					<!-- Current Song -->
					<div class="glass" id="song-card" sse-swap="song">
						@SongComponent("")
					</div>

					<!-- Audio Stats -->
					<div class="glass flex justify-between" id="audio-card" sse-swap="audio">
						@AudioStatsComponent(0, 0)
					</div>
				</div>

				<!-- Right Column: QR Code & Logs -->
				<div class="space-y-6" id="qr-card" sse-swap="qrcode">
					@QRComponent(AppState{Status: StatusInitializing}.Connections)
				</div>
			</div>
		</div>
	}
}

templ StatusComponent(state AppState) {
	<h2 class="text-sm uppercase text-muted mb-2">System Status</h2>
	<div class="flex items-center space-x-3">
		if state.Status == StatusConnected || state.Status == StatusPolling {
			<span class="status-indicator status-success">
			  <span class="status-ping"></span>
			  <span class="status-dot"></span>
			</span>
			<span class="text-2xl font-semibold text-success">{ string(state.Status) }</span>
		} else if state.Status == StatusPairingRequired {
			<span class="status-indicator status-warning">
			  <span class="status-ping"></span>
			  <span class="status-dot"></span>
			</span>
			<span class="text-2xl font-semibold text-warning">{ string(state.Status) }</span>
		} else if state.Status == StatusKilled {
			<span class="text-3xl font-black text-warning tracking-widest text-center block w-full py-6">
			  🎉 WINNER! BOT IS PERMANENTLY DISABLED
			</span>
		} else if state.Status == StatusError || state.Status == StatusAudioExhausted {
			<span class="status-indicator status-danger">
			  <span class="status-ping"></span>
			  <span class="status-dot"></span>
			</span>
			<span class="text-2xl font-semibold text-danger">{ string(state.Status) }</span>
		} else if state.Status == StatusSleeping {
			<span class="status-indicator status-neutral">
			  <span class="status-dot"></span>
			</span>
			<span class="text-2xl font-semibold text-muted">{ string(state.Status) }</span>
		} else {
			<span class="status-indicator status-neutral">
			  <span class="status-dot"></span>
			</span>
			<span class="text-2xl font-semibold text-muted">{ string(state.Status) }</span>
		}
	</div>
	if state.LastError != "" {
		<div class="error-box">
			{ state.LastError }
		</div>
	}
}

templ SongComponent(song string) {
	<h2 class="text-sm uppercase text-muted mb-2">Currently Playing</h2>
	if song == "" {
		<div class="text-xl text-muted italic">Waiting for broadcast...</div>
	} else {
		<div class="text-2xl font-bold">{ song }</div>
	}
}

templ AudioStatsComponent(unused, used int) {
	<div class="flex-grow">
		<h2 class="text-sm uppercase text-muted mb-2">Unused Audios</h2>
		<div class="text-3xl font-bold text-success">{ fmt.Sprintf("%d", unused) }</div>
	</div>
	<div class="flex-grow">
		<h2 class="text-sm uppercase text-muted mb-2">Used Audios</h2>
		<div class="text-3xl font-bold text-warning">{ fmt.Sprintf("%d", used) }</div>
	</div>
}

templ QRComponent(conns []WAConnectionState) {
	for _, conn := range conns {
		<div class="glass qr-card mb-4">
			<h2 class="text-sm uppercase text-muted mb-4">WhatsApp Pairing ({ conn.Phone })</h2>
			<div class="qr-container">
				if conn.QRCodeData == "" {
					<div class="text-muted text-center">
						<svg class="svg-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
						<p>Session active.<br/>No QR code needed.</p>
					</div>
				} else {
					<img src={ conn.QRCodeData } class="qr-image" alt="WhatsApp QR Code"/>
			<div class="progress-bar">
				<div id="qr-progress" class="progress-fill"></div>
			</div>
			<p class="qr-text">Expires in <span id="qr-countdown">40</span>s</p>
			
			<script>
				(function() {
					let timeLeft = 40;
					const progress = document.getElementById('qr-progress');
					const countdown = document.getElementById('qr-countdown');
					
					const timer = setInterval(() => {
						timeLeft -= 0.1;
						if (timeLeft <= 0) {
							clearInterval(timer);
							progress.style.width = '0%';
							countdown.innerText = '0';
						} else {
					<script>
						(function() {
							let timeLeft = 40;
							const progress = document.getElementById('qr-progress');
							const countdown = document.getElementById('qr-countdown');
							
							const timer = setInterval(() => {
								timeLeft -= 0.1;
								if (timeLeft <= 0) {
									clearInterval(timer);
									progress.style.width = '0%';
									countdown.innerText = '0';
								} else {
									progress.style.width = (timeLeft / 40 * 100) + '%';
									countdown.innerText = Math.ceil(timeLeft);
								}
							}, 100);
						})();
					</script>
				}
			</div>
		</div>
	}
}

templ LogsPage() {
	@Layout("Live Logs - ProFM Jaguare") {
		<div class="container h-screen flex flex-col" hx-ext="sse" sse-connect="/events/logs">
			<header class="header mb-4">
				<div>
					<h1 class="title">🐆 Live Logs</h1>
					<p class="text-muted text-sm">Streaming system output...</p>
				</div>
				<a href="/" class="btn btn-secondary btn-sm">Back to Dashboard</a>
			</header>

			<!-- We use an auto-scrolling container for logs -->
			<div class="logs-container">
				<pre id="log-container" class="logs-pre" sse-swap="log" hx-swap="beforeend"></pre>
			</div>

			<script>
				const container = document.getElementById('log-container');
				// Simple observer to auto-scroll when new content arrives
				const observer = new MutationObserver(() => {
					container.scrollTop = container.scrollHeight;
				});
				observer.observe(container, { childList: true });
			</script>
		</div>
	}
}

templ DataViewer(files []FileInfo) {
	@Layout("Data Viewer - ProFM Jaguare") {
		<div class="container">
			<header class="header flex justify-between items-center mb-6">
				<h1 class="title m-0">📂 Data Viewer</h1>
				<a href="/" class="btn btn-secondary btn-sm">Back to Dashboard</a>
			</header>

			<div class="glass p-6 overflow-x-auto">
				<table class="w-full text-left border-collapse">
					<thead>
						<tr class="border-b border-white/10 text-sm tracking-widest text-white/50 uppercase">
							<th class="p-3">File</th>
							<th class="p-3">Size</th>
							<th class="p-3">Modified</th>
							<th class="p-3">Preview</th>
						</tr>
					</thead>
					<tbody>
						for _, f := range files {
							if !f.IsDir {
								<tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
									<td class="p-3 font-mono text-sm break-all">
										<a href={ templ.URL("/raw-data/" + f.Path) } target="_blank" class="text-primary hover:underline">
											{ f.Path }
										</a>
									</td>
									<td class="p-3 text-sm text-white/70">
										{ fmt.Sprintf("%d bytes", f.Size) }
									</td>
									<td class="p-3 text-sm text-white/70 whitespace-nowrap">
										{ f.ModTime }
									</td>
									<td class="p-3">
										if strings.HasSuffix(f.Name, ".ogg") || strings.HasSuffix(f.Name, ".mp3") || strings.HasSuffix(f.Name, ".wav") {
											<audio controls preload="none" style="height: 32px; width: 250px;">
												<source src={ "/raw-data/" + f.Path } type="audio/ogg" />
												Your browser does not support the audio element.
											</audio>
										}
									</td>
								</tr>
							}
						}
						if len(files) == 0 {
							<tr>
								<td colspan="4" class="p-6 text-center text-white/50">No files found.</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

templ RadioLogsPage(logs []RadioLog) {
	@Layout("Radio Log History - ProFM Jaguare") {
		<div class="container">
			<header class="header flex justify-between items-center mb-6">
				<h1 class="title m-0">📻 Radio Log History</h1>
				<a href="/" class="btn btn-secondary btn-sm">Back to Dashboard</a>
			</header>

			<div class="glass p-6 overflow-x-auto">
				<table class="w-full text-left border-collapse">
					<thead>
						<tr class="border-b border-white/10 text-sm tracking-widest text-white/50 uppercase">
							<th class="p-3">ID</th>
							<th class="p-3">Time Played</th>
							<th class="p-3">Artist</th>
							<th class="p-3">Title</th>
						</tr>
					</thead>
					<tbody>
						for _, l := range logs {
							<tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
								<td class="p-3 font-mono text-sm">{ fmt.Sprintf("%d", l.ID) }</td>
								<td class="p-3 text-sm text-white/70">{ l.PlayedDatetime }</td>
								<td class="p-3 font-semibold">{ l.Artist }</td>
								<td class="p-3">{ l.Title }</td>
							</tr>
						}
						if len(logs) == 0 {
							<tr>
								<td colspan="4" class="p-6 text-center text-white/50">No radio logs recorded yet.</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}
